#!/usr/bin/env zsh
# root-probe — does `office on` open the repo you MEANT, from wherever you are?
#
#     bin/root-probe
#
# Mostly no tmux server and never an attach: the two functions that decide WHICH
# directory an office opens on are pure, so a throwaway CODE_ROOT with three git
# repos in it is a complete stand-in. That is the whole point of having this
# probe — the decision used to be provable only by opening an office and reading
# the title. The last two cases do need a server, and get their own, never yours.
#
# The cases are the ways this has actually been wrong:
#
#   - OFFICE_DEFAULT empty is documented as "the one you are in". The substring
#     search matched EVERY line on an empty query and returned whatever sorted
#     first, so standing in `beta` opened `alpha`. From anywhere. For anyone.
#   - a name that does not resolve fell back to $PWD in SILENCE. A CODE_ROOT
#     pointing at a renamed-away folder therefore opened an office on $HOME and
#     said nothing, which is indistinguishable from the tool being broken.
#   - a name that DOES resolve must still win from an unrelated directory.
#   - two repos with ONE basename shared one session, so `office on` in the
#     second attached you to the FIRST repo's office.
#   - `bin/office`, the way in for a shell without the function, was only ever
#     syntax-checked, never run.
emulate -L zsh
setopt err_exit pipe_fail

root=$(cd "$(mktemp -d)" && pwd -P)   # -P: macOS hands back /var, git and cd say /private/var
trap 'rm -rf "$root"' EXIT
for r in alpha beta gamma; do
  mkdir -p "$root/$r" && git -C "$root/$r" init -q
done

export CODE_ROOT=$root
here=${0:A:h}                           # before any cd: $0 is relative
source "$here/../office.zsh" >/dev/null 2>&1
export CODE_ROOT=$root                  # the package re-defaults it on source

fail=0
check() {                               # <what> <got> <want>
  if [[ $2 == $3 ]]; then print "  ok   $1"
  else print -u2 "  FAIL $1\n         got:  $2\n         want: $3"; fail=1
  fi
}

cd "$root/beta"

# 1. no default = the repo you are standing in, not the first one on disk.
OFFICE_DEFAULT= ; dir=$(_office_find "$OFFICE_DEFAULT") || true
[[ -z $dir ]] && dir=$(_office_fallback "$OFFICE_DEFAULT" 2>/dev/null)
check "empty default opens the repo you are in" "$dir" "$root/beta"

# 2. a name that resolves wins from anywhere.
dir=$(_office_find gamma)
check "a named repo opens from another repo" "$dir" "$root/gamma"

# 3. a name that does NOT resolve falls back — and says so on stderr.
dir=$(_office_fallback nosuchrepo 2>"$root/said")
check "an unresolved name still opens something" "$dir" "$root/beta"
if grep -q "nosuchrepo" "$root/said"; then print "  ok   and it says which name missed"
else print -u2 "  FAIL the fallback was silent"; fail=1; fi

# 4. a CODE_ROOT that is not there names ITSELF as the problem, not the name.
CODE_ROOT=$root/gone dir=$(_office_fallback anything 2>"$root/said2") || true
if grep -q "CODE_ROOT" "$root/said2"; then print "  ok   a dead CODE_ROOT names itself"
else print -u2 "  FAIL a dead CODE_ROOT blamed the name instead"; fail=1; fi

# 5. two repos, ONE basename. `~/work/api` and `~/personal/api` both want the
# session `api`, and before @office_root the second `office on` just attached
# you to the first repo's office. This half needs a real server, so it gets its
# own -- never yours -- and everything that would touch the machine is stubbed.
export TMUX_TMPDIR=$(mktemp -d)
export OFFICE_SOLO=1 OFFICE_SESSION_CMD='exec zsh' OFFICE_CHAT_OPEN=0
export OFFICE_DEFAULT_DESKS=1
_office_attach(){ : }; _office_update_check(){ : }; _office_reap(){ : }
_office_always_on_up(){ : }; _office_reload_conf(){ : }; _office_watch_setup(){ : }
said=; _office_say(){ said=$1 }
trap 'tmux kill-server 2>/dev/null; rm -rf "$root" "$TMUX_TMPDIR"' EXIT

for r in work/api personal/api; do
  mkdir -p "$root/$r" && git -C "$root/$r" init -q
done
unsetopt err_exit                       # _office_open is being tested, not trusted
_office_open "$root/work/api"     >/dev/null 2>&1
_office_open "$root/personal/api" >/dev/null 2>&1

check "same-named repos get an office each" \
  "$(tmux list-sessions -F '#{session_name}' 2>/dev/null | sort | tr '\n' ' ')" "api api-2 "
check "the second one is rooted in its own checkout" \
  "$(tmux show -t api-2 -qv @office_root 2>/dev/null)" "$root/personal/api"
check "and reopening it finds the same office" \
  "$(_office_sessfor "$root/personal/api")" "api-2"
if [[ -n $said ]]; then print "  ok   and the rename is said out loud"
else print -u2 "  FAIL the office was renamed in silence"; fail=1; fi

# 6. the launcher on PATH has to RUN, not just parse. CI syntax-checks
# `bin/office` and nothing ever executed it -- and a file that parses can still
# fail to find the package (its `${0:A:h:h}` walk) and answer "command not
# found" to the one shell that needs it: the one without the function.
said_help=$("$here/office" help 2>/dev/null)     # no pipe: `pipe_fail` above   # no pipe: `pipe_fail` above
if [[ $said_help == *"office on"* ]]; then       # would read grep -q's SIGPIPE as a failure
  print "  ok   the PATH launcher loads the package and runs"
else print -u2 "  FAIL bin/office parses but does not run"; fail=1; fi

# 7. `office cd` walks you INTO a worktree instead of trying to check its branch
# out. `git checkout develop` in the main checkout answers "already used by
# worktree at .../desk-5", which is git being right and is also the end of the
# road: the branch is somewhere, and you want to be there.
#
# The trap this pins is a zsh one, and it failed silently: `path` is the array
# tied to $PATH, so parsing `git worktree list` into a variable called `path`
# replaced PATH with one directory mid-loop. No error, no output, an empty list
# and a command that said "not in a git repo" while standing in one.
git -C "$root/alpha" -c user.email=p@p -c user.name=probe commit -q --allow-empty -m init
git -C "$root/alpha" branch -q side
git -C "$root/alpha" worktree add -q "$root/alpha-side" side
cd "$root/alpha"
wtbefore=$(git -C "$root/alpha" rev-parse --abbrev-ref HEAD)
wtrows=(${(f)"$(_office_worktrees)"})
check "office cd sees both worktrees" "$#wtrows" "2"
check "...and names the branch in the other one" \
      "$(printf '%s\n' $wtrows | grep -c '^side')" "1"
office cd side >/dev/null
check "office cd walks the shell into it" "$(pwd -P)" "$root/alpha-side"
check "...and checks nothing out: alpha keeps the branch it had" \
      "$(git -C "$root/alpha" rev-parse --abbrev-ref HEAD)" "$wtbefore"
wtrc=0; office cd no-such-thing >/dev/null 2>&1 || wtrc=$?
check "a name that matches nothing refuses" "$wtrc" "1"
check "...and leaves you where you were" "$(pwd -P)" "$root/alpha-side"

(( fail )) && { print -u2 "\nroot-probe: FAILED"; exit 1 }
print "\nroot-probe: ok"
