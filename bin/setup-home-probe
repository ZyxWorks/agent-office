#!/usr/bin/env python3
"""setup-home-probe: `office setup agents`, `--check` and `--remove`, each in a throwaway $HOME.

Never your own home. Every case is a fresh folder as HOME with a config, a stand-in Firstmate
checkout and whatever files of "yours" the case needs, then `office setup agents` run as a user runs
it, with no terminal, so a question it asks can only ever be answered "no". Each case is a
promise setup/README.md and `office setup agents --help` make. Needs Python and nothing else.

  bin/setup-home-probe
  /usr/bin/python3 bin/setup-home-probe     # macOS: also proves Python 3.9 and the vendored reader
"""

import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
OFFICE = REPO / "bin" / "office"
BEGIN, END = "<!-- agent-office:begin v1 -->", "<!-- agent-office:end -->"
fails = 0


def check(name, ok, detail=""):
    global fails
    print(f"  {'ok  ' if ok else 'FAIL'} {name}" + ("" if ok or not detail else f"\n       {detail}"))
    fails += 0 if ok else 1


class Home:
    def __init__(self, tmp, config="", firstmate=True, office=OFFICE):
        self.office = office
        self.h = Path(tempfile.mkdtemp(dir=tmp))
        (self.h / ".config" / "agent-office").mkdir(parents=True)
        self.config(config)
        if firstmate:
            (self.h / "firstmate").mkdir()

    def config(self, extra):
        (self.h / ".config" / "agent-office" / "config.toml").write_text("schema = 1\n" + extra)

    def run(self, *args, **extra):
        # PYTHONDONTWRITEBYTECODE: macOS's python3 puts its bytecode cache under $HOME/Library
        env = {"HOME": str(self.h), "PATH": os.environ.get("PATH", "/usr/bin:/bin"), "PYTHONDONTWRITEBYTECODE": "1",
               **extra}
        # start_new_session: no controlling terminal, so a question can never block the probe
        return subprocess.run([sys.executable, str(self.office), "setup", "agents", *args], env=env, capture_output=True,
                              text=True, stdin=subprocess.DEVNULL, start_new_session=True)

    def p(self, rel):
        return self.h / rel

    def text(self, rel):
        return self.p(rel).read_text()

    def json(self, rel):
        return json.loads(self.text(rel))

    def files(self):
        return sorted(str(p.relative_to(self.h)) for p in self.h.rglob("*")
                      if (p.is_file() or p.is_symlink()) and ".config" not in p.parts and ".local" not in p.parts)


def out(r):
    return r.stdout + r.stderr


def main():
    with tempfile.TemporaryDirectory() as tmp:
        print("a fresh home")
        h = Home(tmp)
        before = h.files()
        r = h.run("--check")
        check("--check shows the plan and changes nothing", r.returncode == 0 and "create" in r.stdout
              and h.files() == before, out(r))
        r = h.run()
        check("a fresh home needs no question", r.returncode == 0, out(r))
        a = h.text("AGENTS.md")
        check("~/AGENTS.md holds the rules between the markers", a.startswith(BEGIN) and a.rstrip().endswith(END)
              and "with 2 workers" in a)
        check("CLAUDE.md and Codex's AGENTS.md link to it",
              os.readlink(h.p(".claude/CLAUDE.md")) == str(h.p("AGENTS.md"))
              and os.readlink(h.p(".codex/AGENTS.md")) == str(h.p("AGENTS.md")))
        s = h.json(".claude/settings.json")
        check("Claude Code settings have the hooks and the permissions",
              s["permissions"]["defaultMode"] == "auto"
              and any("text-check.mjs" in x["command"] for e in s["hooks"]["PreToolUse"] for x in e["hooks"]))
        check("the hooks are there and executable",
              all(os.access(h.p(f".claude/hooks/{f}"), os.X_OK) for f in ("agents-md.py", "text-check.mjs")))
        check("Firstmate's files and switches are there",
              h.p("firstmate/config/crew-dispatch.json").is_file() and h.p("firstmate/data/captain.md").is_file()
              and h.p("firstmate/config/turnend-churn-absorb").is_file()
              and h.text("firstmate/config/supervision-host") == "claude claude-opus-5-5\n")
        check("no-mistakes and gnhf have their keys", "agent: claude" in h.text(".no-mistakes/config.yaml")
              and "--permission-mode" in h.text(".gnhf/config.yml"))
        check("the theme is not written unless asked for", not h.p(".claude/themes/office.json").exists()
              and "theme" not in s)
        check("what it wrote is on the record",
              h.p(".local/state/agent-office/setup-manifest.json").is_file())
        r = h.run()
        check("a second run changes nothing", r.returncode == 0 and "Nothing to change" in r.stdout, out(r))

        print("your lines, keys and files stay yours")
        h.p("AGENTS.md").write_text("# mine\nmy own rule\n\n" + h.text("AGENTS.md") + "\nmy tail\n")
        s = h.json(".claude/settings.json")
        s["myKey"] = 1
        s["hooks"]["PreToolUse"].append({"matcher": "Read", "hooks": [{"type": "command", "command": "mine"}]})
        s["permissions"]["allow"].append("Bash(mine:*)")
        h.p(".claude/settings.json").write_text(json.dumps(s))
        h.p("firstmate/data/captain.md").write_text("my preferences\n")
        h.config("[setup.machine]\ntest_workers = 5\n")
        r = h.run()
        a = h.text("AGENTS.md")
        check("a new value updates the block with no question", r.returncode == 0 and "with 5 workers" in a, out(r))
        check("your lines around the block stay", a.startswith("# mine\nmy own rule\n") and a.endswith("my tail\n"))
        s = h.json(".claude/settings.json")
        check("your own key, hook and permission stay", s.get("myKey") == 1 and "Bash(mine:*)" in s["permissions"]["allow"]
              and any(e.get("matcher") == "Read" for e in s["hooks"]["PreToolUse"]))
        check("a starter you edited is never written again", h.text("firstmate/data/captain.md") == "my preferences\n")

        print("a change of yours to what Agent Office owns")
        s["model"] = "my-model"
        h.p(".claude/settings.json").write_text(json.dumps(s))
        r = h.run()
        check("it is asked about, and no answer changes nothing",
              r.returncode == 1 and "not confirmed" in r.stderr and h.json(".claude/settings.json")["model"] == "my-model",
              out(r))
        check("the question names your value and Agent Office's", 'yours is "my-model"' in r.stdout, out(r))
        r = h.run("--yes")
        check("--yes takes Agent Office's value and backs yours up first",
              r.returncode == 0 and h.json(".claude/settings.json")["model"] == "claude-opus-5-5"
              and any(h.p(".local/state/agent-office/backups").rglob("settings.json")), out(r))
        hook = h.p(".claude/hooks/agents-md.py")
        hook.write_text(hook.read_text() + "# my change\n")
        r = h.run()
        check("a whole file you changed is never replaced: the new one goes beside it",
              r.returncode == 0 and hook.read_text().endswith("# my change\n")
              and h.p(".claude/hooks/agents-md.py.agent-office-new").is_file(), out(r))

        print("links and what is in the way")
        h = Home(tmp)
        dot = Path(tempfile.mkdtemp(dir=tmp))
        (dot / "settings.json").write_text('{"model": "x"}\n')
        h.p(".claude").mkdir()
        os.symlink(dot / "settings.json", h.p(".claude/settings.json"))
        h.p(".claude/CLAUDE.md").write_text("my own rules\n")
        r = h.run()
        check("a settings file that is a link is never written through",
              r.returncode == 0 and (dot / "settings.json").read_text() == '{"model": "x"}\n'
              and "never written through" in r.stdout, out(r))
        check("a CLAUDE.md that is already there is left alone",
              h.text(".claude/CLAUDE.md") == "my own rules\n" and not h.p(".claude/CLAUDE.md").is_symlink())
        h = Home(tmp)
        os.symlink(dot, h.p(".claude"))
        r = h.run()
        check("a ~/.claude that is a link is never written through", r.returncode == 0
              and not (dot / "hooks").exists() and "is a link to" in r.stdout, out(r))
        check("with ~/.claude a link, every hook file is listed as manual", all(
            ["manual", f"~/.claude/hooks/{n}"] in [x.split() for x in r.stdout.splitlines()]
            for n in ("agents-md.py", "text-check.mjs", "text-check.json")), out(r))
        h = Home(tmp, firstmate=False)
        r = h.run()
        check("no Firstmate home yet: nothing is written where it will go",
              r.returncode == 0 and not h.p("firstmate").exists() and "is not there yet" in r.stdout, out(r))

        print("the theme, on and then off")
        h = Home(tmp, "[setup.claude]\ntheme = true\n")
        h.run()
        check("on: the theme file and the setting", h.p(".claude/themes/office.json").is_file()
              and h.json(".claude/settings.json").get("theme") == "custom:office")
        h.config("[setup.claude]\ntheme = false\n")
        r = h.run()
        check("off: both are taken out again", r.returncode == 0 and not h.p(".claude/themes/office.json").exists()
              and "theme" not in h.json(".claude/settings.json"), out(r))

        print("--remove")
        h = Home(tmp)
        h.p(".claude").mkdir()
        h.p(".claude/settings.json").write_text(json.dumps({"permissions": {"allow": ["Bash(gh-axi:*)"]}, "mine": 1}))
        h.p("AGENTS.md").write_text("my rule\n")
        h.p(".gnhf").mkdir()
        h.p(".gnhf/config.yml").write_text("mine: 1\n")
        h.run("--yes")
        h.p("firstmate/data/captain.md").write_text("my preferences\n")
        r = h.run("--remove", "--yes")
        check("--remove runs", r.returncode == 0, out(r))
        check("the block goes, your lines stay", h.text("AGENTS.md") == "my rule\n", repr(h.text("AGENTS.md")))
        s = h.json(".claude/settings.json")
        check("Agent Office's keys go, yours stay, an entry you had before stays",
              s == {"permissions": {"allow": ["Bash(gh-axi:*)"]}, "mine": 1}, json.dumps(s))
        check("its YAML keys and their comment go, yours stay", h.text(".gnhf/config.yml") == "mine: 1\n",
              repr(h.text(".gnhf/config.yml")))
        check("a file that held only Agent Office's keys goes", not h.p(".no-mistakes/config.yaml").exists())
        check("its links, hooks, files and switches go", not h.p(".claude/CLAUDE.md").is_symlink()
              and not h.p(".claude/hooks/text-check.mjs").exists()
              and not h.p("firstmate/config/crew-dispatch.json").exists()
              and not h.p("firstmate/config/turnend-churn-absorb").exists())
        check("your starter stays", h.text("firstmate/data/captain.md") == "my preferences\n")
        r = h.run("--remove")
        check("a second --remove has nothing to do", r.returncode == 0 and "Nothing to change" in r.stdout, out(r))

        print("what you took out stays out")
        h = Home(tmp)
        h.run()
        s = h.json(".claude/settings.json")
        s["permissions"]["allow"].remove("Bash(git push -u origin fm/*)")
        del s["permissions"]["defaultMode"]
        h.p(".claude/settings.json").write_text(json.dumps(s, indent=2) + "\n")
        g = h.text(".gnhf/config.yml")
        h.p(".gnhf/config.yml").write_text(g.replace("agentArgsOverride:\n  claude:\n    - --permission-mode\n"
                                                     "    - auto\n", ""))
        r = h.run()
        s = h.json(".claude/settings.json")
        check("a deleted allow entry, JSON key and YAML key stay gone", r.returncode == 0
              and "Bash(git push -u origin fm/*)" not in s["permissions"]["allow"]
              and "defaultMode" not in s["permissions"] and "agentArgsOverride" not in h.text(".gnhf/config.yml"), out(r))
        check("the run says each is left out",
              'you removed permissions.allow entry "Bash(git push -u origin fm/*)" in ~/.claude/settings.json: '
              "left out" in r.stdout
              and "you removed permissions.defaultMode in ~/.claude/settings.json: left out" in r.stdout
              and "you removed agentArgsOverride in ~/.gnhf/config.yml: left out" in r.stdout, out(r))
        r = h.run()
        check("a third run has nothing to change", r.returncode == 0 and "Nothing to change" in r.stdout, out(r))
        r = h.run("--reset-key", "~/.claude/settings.json:permissions.defaultMode")
        check("--reset-key takes it off the record", r.returncode == 0 and "back on the record" in r.stdout, out(r))
        r = h.run()
        s = h.json(".claude/settings.json")
        check("the next run puts back only that one", r.returncode == 0 and s["permissions"]["defaultMode"] == "auto"
              and "Bash(git push -u origin fm/*)" not in s["permissions"]["allow"]
              and "agentArgsOverride" not in h.text(".gnhf/config.yml"), out(r))
        r = h.run("--reset-key", "~/.claude/settings.json:nothing.like.this")
        check("--reset-key for what you did not remove is an error that lists what you did",
              r.returncode == 1 and "~/.gnhf/config.yml:agentArgsOverride" in r.stderr, out(r))
        r = h.run("--remove", "--yes")
        s = h.json(".claude/settings.json")
        check("--remove still works after a deletion", r.returncode == 0 and "permissions" not in s
              and not h.p(".gnhf/config.yml").exists(), out(r))

        print("--remove leaves alone what it should")
        h = Home(tmp)
        h.run()
        dot = Path(tempfile.mkdtemp(dir=tmp)) / "claude"
        os.rename(h.p(".claude"), dot)
        os.symlink(dot, h.p(".claude"))
        settings = (dot / "settings.json").read_text()
        r = h.run("--remove", "--yes")
        check("nothing is taken out through a linked folder", r.returncode == 0
              and (dot / "settings.json").read_text() == settings and (dot / "hooks" / "text-check.mjs").is_file()
              and "never written through" in r.stdout, out(r))
        r = h.run("--remove", "--yes")
        check("it stays on the record, a manual item", "never written through" in r.stdout, out(r))
        h = Home(tmp)
        h.run()
        mine = json.dumps({"mine": 1}, indent=4) + "\n"
        h.p(".claude/settings.json").write_text(mine)
        r = h.run("--remove", "--yes")
        check("a JSON file with none of Agent Office's keys left is not rewritten",
              r.returncode == 0 and h.text(".claude/settings.json") == mine, out(r))
        h = Home(tmp)
        h.run()
        h.p(".gnhf/config.yml").write_text("mine: 1")
        r = h.run("--remove", "--yes")
        check("a YAML file with none of Agent Office's keys left is not rewritten",
              r.returncode == 0 and h.text(".gnhf/config.yml") == "mine: 1", out(r))

        print("--remove puts back a value of yours it replaced")
        h = Home(tmp)
        h.p(".claude").mkdir()
        h.p(".claude/settings.json").write_text(json.dumps({"model": "opus", "permissions": {"defaultMode": "ask"}}))
        h.p(".gnhf").mkdir()
        h.p(".gnhf/config.yml").write_text("maxConsecutiveFailures: 9\npreventSleep: false\n")
        r = h.run("--yes")
        check("--yes replaces them", r.returncode == 0 and h.json(".claude/settings.json")["model"] == "claude-opus-5-5"
              and "maxConsecutiveFailures: 3" in h.text(".gnhf/config.yml"), out(r))
        s = h.json(".claude/settings.json")
        s["permissions"]["defaultMode"] = "plan"
        h.p(".claude/settings.json").write_text(json.dumps(s))
        h.p(".gnhf/config.yml").write_text(h.text(".gnhf/config.yml").replace("preventSleep: true", "preventSleep: no"))
        r = h.run("--remove", "--yes")
        s = h.json(".claude/settings.json")
        check("--remove runs", r.returncode == 0, out(r))
        check("JSON: your old value goes back, one you changed since stays, one never there goes",
              s.get("model") == "opus" and s["permissions"].get("defaultMode") == "plan"
              and "hooks" not in s and "allow" not in s["permissions"], json.dumps(s))
        g = h.text(".gnhf/config.yml")
        check("YAML: your old value goes back, one you changed since stays, one never there goes",
              "maxConsecutiveFailures: 9" in g and "preventSleep: no" in g and "agent:" not in g
              and "agentArgsOverride" not in g, repr(g))

        print("a bad config")
        h = Home(tmp, "[setup.machine]\ntest_workers = 0\n")
        r = h.run()
        check("is an error, and nothing is written", r.returncode == 1 and "setup.machine.test_workers" in r.stderr
              and not h.p("AGENTS.md").exists(), out(r))

        print("the codex harness")
        h = Home(tmp, '[firstmate]\nharness = "codex"\n')
        r = h.run()
        check("with no models of its own it refuses, and nothing is written",
              r.returncode == 1 and "setup.models.default.model" in r.stderr and not h.p("AGENTS.md").exists(), out(r))
        h.config('[firstmate]\nharness = "codex"\n[setup.models.default]\nmodel = "cx-a"\neffort = "high"\n'
                 '[setup.models.mechanical]\nmodel = "cx-b"\neffort = "low"\n')
        r = h.run()
        check("with its models: gnhf is not written, and the run says why",
              r.returncode == 0 and not h.p(".gnhf/config.yml").exists() and "not written: gnhf" in r.stdout
              and h.text("firstmate/config/supervision-host") == "codex cx-a\n", out(r))

        skill_packs(tmp)

    print(f"\n{fails} failed" if fails else "\nall passed")
    return 1 if fails else 0


def git(where, *args):
    return subprocess.run(["git", "-C", str(where), "-c", "user.name=probe", "-c", "user.email=probe@example.invalid",
                           "-c", "commit.gpgsign=false", *args], check=True, capture_output=True, text=True).stdout.strip()


def skill_packs(tmp):
    """A copy of this checkout whose no-ai-slop pin names a local repository: nothing is downloaded."""
    print("a skill pack")
    sys.path.insert(0, str(REPO / "lib"))
    from agent_office.vendors import tree_hash
    src = Path(tmp) / "no-ai-slop-upstream"
    (src / "skills" / "no-ai-slop").mkdir(parents=True)
    (src / "skills" / "no-ai-slop" / "SKILL.md").write_text("one\n")
    (src / "AGENTS.md").write_text("upstream's own rules, never checked out\n")
    (src / "tools").mkdir()
    (src / "tools" / "install.sh").write_text("echo not for you\n")
    git(src, "init", "-q", "-b", "main")
    git(src, "config", "uploadpack.allowAnySHA1InWant", "true")   # as GitHub, for a pin that is not the tip
    git(src, "add", "-A")
    git(src, "commit", "-q", "-m", "one")
    one = git(src, "rev-parse", "HEAD")
    sha_one = tree_hash(src, ["skills/no-ai-slop"])
    (src / "skills" / "no-ai-slop" / "SKILL.md").write_text("two\n")
    (src / "skills" / "no-ai-slop" / "eval.md").write_text("eval\n")
    git(src, "add", "-A")
    git(src, "commit", "-q", "-m", "two")
    two = git(src, "rev-parse", "HEAD")
    sha_two = tree_hash(src, ["skills/no-ai-slop"])

    copy = Path(tmp) / "office"
    shutil.copytree(REPO, copy, ignore=shutil.ignore_patterns(".git", "__pycache__"))
    comps = copy / "config" / "components.toml"
    orig = comps.read_text()

    def pin(commit, sha):
        entry = (f'name = "no-ai-slop"\nrepo = "{src}"\ncommit = "{commit}"\npaths = ["skills/no-ai-slop"]\n'
                 f'sha256 = "{sha}"\n')
        text = re.sub(r'name = "no-ai-slop"\n(?:[a-z0-9]+ = .*\n)+?(?=license)', lambda _: entry, orig)
        # every other pack from an upstream that is not there: the probe never downloads
        comps.write_text(re.sub(r'repo = "https://[^"]*"', f'repo = "{Path(tmp) / "gone"}"', text))

    pack = ".local/share/agent-office/vendors/no-ai-slop"
    h = Home(tmp, "[setup.skills]\nno_ai_slop = true\n", office=copy / "bin" / "office")
    pin(one, "0" * 64)
    r = h.run()
    check("files that are not the pinned ones are not put in place", r.returncode == 1
          and "is not the pinned files" in r.stderr and not h.p(pack).exists()
          and not any(h.p(".local/share/agent-office/vendors").iterdir()), out(r))
    pin(one, sha_one)
    r = h.run()
    check("on: checked out at the pin, only the folders it names", r.returncode == 0
          and git(h.p(pack), "rev-parse", "HEAD") == one and h.text(f"{pack}/skills/no-ai-slop/SKILL.md") == "one\n"
          and not h.p(f"{pack}/tools").exists() and not h.p(f"{pack}/AGENTS.md").exists(), out(r))
    w = h.text(".agents/skills/no-ai-slop/SKILL.md") if h.p(".agents/skills/no-ai-slop/SKILL.md").is_file() else ""
    check("its skill points at the checkout, and Claude Code sees it through a link",
          f"`{h.p(pack)}/skills/no-ai-slop/SKILL.md`" in w and "{{" not in w
          and os.readlink(h.p(".claude/skills/no-ai-slop")) == str(h.p(".agents/skills/no-ai-slop")), w)
    r = h.run("--check")
    check("a second run has nothing to do", r.returncode == 0 and "Nothing to change" in r.stdout, out(r))
    r = h.run("--check", GIT_DIR=str(src / ".git"))
    check("also from inside another repository's git hook (GIT_DIR set)", r.returncode == 0
          and "Nothing to change" in r.stdout, out(r))
    pin(two, sha_two)
    r = h.run("--check")
    check("a new pin is an update, with where to read the change", "update   ~/" + pack in r.stdout
          and f"{one[:12]} -> {two[:12]}: read the change at {src}/compare/{one}...{two}" in r.stdout, out(r))
    r = h.run()
    check("and moves it", r.returncode == 0 and git(h.p(pack), "rev-parse", "HEAD") == two
          and h.p(f"{pack}/skills/no-ai-slop/eval.md").is_file(), out(r))
    r = h.run("--remove")
    check("--remove takes out the pack, its skill folder and the link", r.returncode == 0 and not h.p(pack).exists()
          and not h.p(".agents/skills/no-ai-slop").exists() and not h.p(".claude/skills/no-ai-slop").is_symlink(),
          out(r))
    h.config("[setup.skills]\nno_ai_slop = true\nmarketing = true\n")
    r = h.run()
    check("an upstream that cannot be reached: the run goes on, says which, and exits 1", r.returncode == 1
          and "1 skill pack(s) could not be checked out" in r.stderr and "marketingskills" in r.stderr
          and h.p(pack).is_dir() and h.p(".agents/skills/marketing/SKILL.md").is_file(), out(r))
    h.config("[setup.skills]\nno_ai_slop = true\n")
    h.run()
    (h.p(pack) / "skills" / "no-ai-slop" / "SKILL.md").write_text("mine\n")
    pin(one, sha_one)
    r = h.run()
    check("a pack you changed is left as it is, and said so", r.returncode == 0
          and h.text(f"{pack}/skills/no-ai-slop/SKILL.md") == "mine\n" and "changed by hand" in r.stdout, out(r))
    h.config("[setup.skills]\nno_ai_slop = false\n")
    r = h.run()
    check("turned off: a pack you changed stays", r.returncode == 0 and h.p(pack).is_dir()
          and not h.p(".agents/skills/no-ai-slop/SKILL.md").exists(), out(r))


if __name__ == "__main__":
    sys.exit(main())
