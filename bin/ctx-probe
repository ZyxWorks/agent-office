#!/usr/bin/env zsh
# ctx-probe — does a desk's border report the right context number, and go loud
# at the right marks?
#
# Run it after ANY change to bin/office-ctx or to Claude Code's session and
# transcript layout.
#
#     bin/ctx-probe
#
# It needs no Claude Code and no API call. bin/office-ctx reads exactly three
# things — the pane's process group, ~/.claude/sessions/<pid>.json, and
# ~/.claude/projects/<slug>/<id>.jsonl — so a fake $HOME containing those two
# files is a complete, deterministic stand-in, and the pane's own pid stands in
# for the agent's. That also means this probe is the written-down version of the
# layout office-ctx depends on: if Claude Code moves those files, this fails and
# the comment at the top of office-ctx tells you what to change.
#
# The two cases worth having on purpose:
#
#   - cache_read is nearly ALL of a real context. Reading "input_tokens" alone is
#     the obvious mistake and reports a few hundred tokens for a session holding
#     two hundred thousand, so the fixture below has that exact shape: 1 input,
#     1007 created, 217198 read.
#   - the same keys appear AGAIN inside "iterations", after the top-level ones. A
#     reader that takes the last hit rather than the first gets a plausible wrong
#     answer, which is the worst kind, so the fixture carries both.
emulate -L zsh
zmodload -F zsh/stat b:zstat 2>/dev/null   # the mtime check below, without a stat(1) that differs per OS

export TMUX_TMPDIR=$(mktemp -d)
fake=$(mktemp -d)                       # a $HOME with nothing but Claude's files
here=${0:A:h}
cleanup() { tmux -L ctxprobe kill-server 2>/dev/null; rm -rf "$TMUX_TMPDIR" "$fake" }
trap cleanup EXIT INT TERM

fail=0
ok()   { print "  ok   $1" }
bad()  { print -u2 "  FAIL $1"; fail=1 }
want() { [[ $2 == $3 ]] && ok "$1" || bad "$1: got '$2', wanted '$3'" }

tmux -L ctxprobe -f /dev/null new-session -d -x 80 -y 12 'exec cat'
pane=$(tmux -L ctxprobe list-panes -F '#{pane_id}' | head -1)
pid=$(tmux -L ctxprobe display -p -t "$pane" '#{pane_pid}')
tmux -L ctxprobe set -g @office_ctx_warn 400000
tmux -L ctxprobe set -g @office_ctx_alarm 600000
tmux -L ctxprobe set -g @office_ctx_style_warn 'WARN>'
tmux -L ctxprobe set -g @office_ctx_style_alarm 'ALARM>'

# office-ctx calls plain `tmux`, so point that at this server, and hand it the
# fake HOME. Everything else about it is real.
shim=$(mktemp -d)
# printf, not `print -r`: -r is exactly the flag that stops \n being a newline, so
# that wrote a one-line file whose shebang ran nothing, every call returned empty,
# and the two "must be silent" checks passed while testing nothing at all.
printf '#!/bin/sh\nexec %s -L ctxprobe "$@"\n' "$(command -v tmux)" > $shim/tmux
chmod +x $shim/tmux
ctx() { PATH="$shim:$PATH" HOME="$fake" "$here/office-ctx" "$pane" }

# --- no Claude Code at all ----------------------------------------------------
want "no ~/.claude/sessions: silent" "$(ctx)" ""

sid=00000000-1111-2222-3333-444444444444
mkdir -p "$fake/.claude/sessions"
print -r -- "{\"pid\":$pid,\"sessionId\":\"$sid\",\"cwd\":\"/tmp/demo/repo\",\"kind\":\"interactive\"}" \
  > "$fake/.claude/sessions/$pid.json"
want "a session but no transcript: silent" "$(ctx)" ""

# The slug rule: the LAUNCH directory with / and . beaten into -.
slug=$(print -r -- /tmp/demo/repo | tr '/.' '--')
mkdir -p "$fake/.claude/projects/$slug"
tx="$fake/.claude/projects/$slug/$sid.jsonl"

# <input> <created> <read> — written the way Claude Code writes it, iterations and
# all, so the "first hit per key" rule is actually under test.
fixture() {
  print -r -- "{\"type\":\"user\",\"message\":{\"role\":\"user\"}}"
  print -r -- "{\"type\":\"assistant\",\"message\":{\"usage\":{\"input_tokens\":$1,\"cache_creation_input_tokens\":$2,\"cache_read_input_tokens\":$3,\"output_tokens\":683,\"output_tokens_details\":{\"thinking_tokens\":120},\"iterations\":[{\"input_tokens\":9999,\"output_tokens\":1,\"cache_read_input_tokens\":9999,\"cache_creation_input_tokens\":9999}]}}}"
}

fixture 1 1007 217198 > "$tx"
want "a real record: input + created + read" "$(ctx)" "  218k#[default]"

# ...and the number has to follow the LAST record, not the first.
fixture 2 3000 300000 >> "$tx"
want "a later record wins" "$(ctx)" "  303k#[default]"

# --- the marks -----------------------------------------------------------------
fixture 0 0 399999 > "$tx"
want "just under the warn mark: no style" "$(ctx)" "  399k#[default]"
fixture 0 0 400000 > "$tx"
want "at the warn mark: warn style" "$(ctx)" "  WARN>400k#[default]"
fixture 0 0 512345 > "$tx"
want "between the marks: still warn" "$(ctx)" "  WARN>512k#[default]"
fixture 0 0 600000 > "$tx"
want "at the alarm mark: alarm style" "$(ctx)" "  ALARM>600k#[default]"
fixture 0 0 1250000 > "$tx"
want "over a million: reads in M" "$(ctx)" "  ALARM>1.2M#[default]"

# --- the marks are the operator's ----------------------------------------------
tmux -L ctxprobe set -g @office_ctx_warn 120000
tmux -L ctxprobe set -g @office_ctx_alarm 170000
fixture 0 0 130000 > "$tx"
want "a 200k window: warn where you put it" "$(ctx)" "  WARN>130k#[default]"
tmux -L ctxprobe set -g @office_ctx_warn 400000
tmux -L ctxprobe set -g @office_ctx_alarm 600000

# --- the fallback when the slug rule does not hold -----------------------------
# The slug is Claude Code's rule, not ours, so the id is globbed for as well.
mkdir -p "$fake/.claude/projects/some-other-slug"
mv "$tx" "$fake/.claude/projects/some-other-slug/$sid.jsonl"
fixture 0 0 250000 > "$fake/.claude/projects/some-other-slug/$sid.jsonl"
rmdir "$fake/.claude/projects/$slug"
want "slug moved: found by session id anyway" "$(ctx)" "  250k#[default]"

# --- when this desk last wrote -------------------------------------------------
# The transcript's mtime, left on the pane for office-attn. That readout is the
# CACHE clock -- an hour with nothing written and the next thing you say is
# charged as a new conversation -- and the screen it used to be read off cannot
# answer it: a scroll, a resize or a zoom all reset the screen and not the file.
tx2="$fake/.claude/projects/some-other-slug/$sid.jsonl"
touch -t 202001010000 "$tx2"
ctx >/dev/null
want "the transcript's mtime lands on the pane" \
  "$(tmux -L ctxprobe show -pqv -t "$pane" @office_wrote)" \
  "$(zstat +mtime "$tx2")"

# ...and a dead session never keeps counting. The agent ending leaves the pane a
# shell with its CLAUDE kind intact, so this script goes on being called and finds
# nothing; anything left behind would have office-attn timing a session that is
# over. Both ways out that find no transcript have to drop it.
mv "$tx2" "$tx2.gone"
ctx >/dev/null
want "no transcript: the clock is dropped" \
  "$(tmux -L ctxprobe show -pqv -t "$pane" @office_wrote)" ""
mv "$tx2.gone" "$tx2"
ctx >/dev/null
mv "$fake/.claude/sessions/$pid.json" "$fake/.claude/sessions/$pid.gone"
ctx >/dev/null
want "the agent ended: the clock is dropped" \
  "$(tmux -L ctxprobe show -pqv -t "$pane" @office_wrote)" ""
mv "$fake/.claude/sessions/$pid.gone" "$fake/.claude/sessions/$pid.json"

# --- a Codex desk ---------------------------------------------------------------
# Codex keys nothing by pid, so the trick above has nothing to grab. What it does
# record is the directory it started in, on its first line, and in an office that
# is exact: every agent after the first gets its own worktree, so two Codex desks
# never share a cwd. The clock is the file's mtime, which needs no format at all --
# and there is deliberately NO number, because a usage record is Claude Code's
# shape and a plausible wrong number on a border is worse than an empty one.
pcwd=$(tmux -L ctxprobe display -p -t "$pane" '#{pane_current_path}')
mkdir -p "$fake/.codex/sessions/2026/09/18"
roll="$fake/.codex/sessions/2026/09/18/rollout-2026-09-18T09-36-34-01a0b372-19b1-76f2-98ba-b97e293779c5.jsonl"
print -r -- "{\"timestamp\":\"2026-09-18T07:36:34.492Z\",\"type\":\"session_meta\",\"payload\":{\"session_id\":\"01a0b372\",\"cwd\":\"$pcwd\",\"originator\":\"Codex CLI\"}}" > "$roll"
print -r -- '{"type":"event_msg","payload":{"type":"token_count","info":{"last_token_usage":{"input_tokens":0,"total_tokens":108060}}}}' >> "$roll"
touch -t 202002020000 "$roll"
# the Claude reader has to come up empty, or it answers first and this proves nothing
mv "$fake/.claude/sessions/$pid.json" "$fake/.claude/sessions/$pid.gone"
want "a Codex desk: no number on the border"  "$(ctx)" ""
want "a Codex desk: but its clock is read"    \
  "$(tmux -L ctxprobe show -pqv -t "$pane" @office_wrote)" "$(zstat +mtime "$roll")"
# ...and a rollout from a DIFFERENT directory is not this desk's
mv "$roll" "$roll.other"
print -r -- "{\"type\":\"session_meta\",\"payload\":{\"cwd\":\"/somewhere/else\"}}" > "$roll.other"
ctx >/dev/null
want "a Codex rollout from another directory is ignored" \
  "$(tmux -L ctxprobe show -pqv -t "$pane" @office_wrote)" ""
rm -f "$roll.other"

# --- any other CLI: @office_tx_cmd ----------------------------------------------
# Twenty-odd agent CLIs exist and office ships readers for two. The third question
# this asks is yours: a command handed the pane id that prints a path. It is tried
# FIRST, so it also overrides a reader that would otherwise answer.
mv "$fake/.claude/sessions/$pid.gone" "$fake/.claude/sessions/$pid.json"
mine="$shim/my-transcript.jsonl"
print -r -- '{"mine":1}' > "$mine"
touch -t 202003030000 "$mine"
printf '#!/bin/sh\nprintf %%s %s\n' "$mine" > "$shim/mytx"; chmod +x "$shim/mytx"
# Set over a LIVE cache, which is the case that matters: this call caches the
# Claude transcript, readable and with its session file present, so nothing about
# the pane is about to change. A hook you have just set has to take effect on the
# next tick anyway — @office_tx_cmd is part of the cache key for exactly this.
ctx >/dev/null
want "cached first: the Claude transcript" \
  "$(tmux -L ctxprobe show -pqv -t "$pane" @office_tx)" \
  "$fake/.claude/projects/some-other-slug/$sid.jsonl"
tmux -L ctxprobe set -p -t "$pane" @office_tx_cmd "$shim/mytx"
ctx >/dev/null
want "@office_tx_cmd answers, and beats the built-in readers" \
  "$(tmux -L ctxprobe show -pqv -t "$pane" @office_wrote)" "$(zstat +mtime "$mine")"
# ...and taking it away hands the desk straight back to the built-in reader.
tmux -L ctxprobe set -up -t "$pane" @office_tx_cmd
ctx >/dev/null
want "...and removing it hands the desk back" \
  "$(tmux -L ctxprobe show -pqv -t "$pane" @office_tx)" \
  "$fake/.claude/projects/some-other-slug/$sid.jsonl"
rm -rf "$fake/.codex"
ctx >/dev/null

# --- rubbish in ----------------------------------------------------------------
# A border is not a place to print a parse error, and half a line is what `tail -c`
# leaves behind on any file bigger than its bound.
print -r -- '{"type":"assistant","message":{"usage":{"cache_read_' \
  > "$fake/.claude/projects/some-other-slug/$sid.jsonl"
want "a truncated record: silent"             "$(ctx)" ""
print -r -- 'not json at all' > "$fake/.claude/projects/some-other-slug/$sid.jsonl"
want "not json at all: silent"                "$(ctx)" ""

# --- the border asks for it ------------------------------------------------------
# Last, because sourcing the theme replaces the style options everything above
# depends on. A theme is allowed to override pane-border-format, so `#{E:@office_ctx}`
# is a line someone can drop by accident and nothing else would notice.
tmux -L ctxprobe source-file "$here/../office.tmux.conf" 2>/dev/null
fmt=$(tmux -L ctxprobe show -gqv pane-border-format)
[[ $fmt == *'#{E:@office_ctx}'* ]] && ok "office.tmux.conf's border asks for it" \
  || bad "office.tmux.conf's border asks for it: not in '$fmt'"
tmux -L ctxprobe source-file "$here/../theme/office-theme.tmux.conf" 2>/dev/null
fmt=$(tmux -L ctxprobe show -gqv pane-border-format)
[[ $fmt == *'#{E:@office_ctx}'* ]] && ok "and the theme keeps it" \
  || bad "and the theme keeps it: not in '$fmt'"
# The theme is the only place a colour may come from, and it has to fill both.
for s in warn alarm; do
  v=$(tmux -L ctxprobe show -gqv "@office_ctx_style_$s")
  [[ $v == *'#[fg=#'* ]] && ok "the theme sets the $s tone" \
    || bad "the theme sets the $s tone: got '$v'"
done

rm -rf $shim
(( fail )) && { print -u2 "\nctx-probe FAILED"; exit 1 }
print "\nctx-probe passed"
