      r.returncode < 0 and rec["state"] == "running" and rec["current"] == "gh-axi"
      and rec["results"]["herdr"]["state"] == "updated", f"{r.returncode} {rec}")
before = h.snapshot()
r = h.run("--check")
check("the next --check reports it, and writes nothing", r.returncode == 0 and h.snapshot() == before and re.search(
    r"The last office update \(started \S+\) was cut off while it updated gh-axi\. It had updated: herdr\.", r.stdout), r.stdout)
(h.root / "npm-kill-gh-axi").unlink()
r = h.run("--yes")
got = rows(r.stdout.split("Results:")[-1])
check("the next run picks it up: what was done stays done, the rest is finished, exit 0", r.returncode == 0
      and "was cut off while it updated gh-axi" in r.stdout
      and re.fullmatch(r"updated: 0\.9\.0 -> 0\.9\.1" + kept_at("herdr") + r" \(earlier in this update\)", got.get("herdr", ""))
      and got.get("gh-axi") == "updated: 0.1.30 -> 0.1.35", r.stdout + r.stderr)
check("and the record is closed", json.loads(h.record.read_text())["state"] == "done")
r = h.run("--check")
check("so nothing is reported any more", "cut off" not in r.stdout, r.stdout)
h.done()

