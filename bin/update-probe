r = h.run("--check")
check("when the last run stopped on it, the plan installs it again", re.fullmatch(
    r"update: unknown +0\.1\.35 .*", rows(r.stdout).get("gh-axi", "")) and "its owner installs the target again"
      in under(r.stdout, "gh-axi"), r.stdout)
r = h.run("--yes")
got = rows(r.stdout.split("Results:")[-1])
check("and the run does, so the update is complete", got.get("gh-axi") == "updated: unknown -> 0.1.35"
      and json.loads(h.record.read_text())["state"] == "done", r.stdout + r.stderr)
h.done()

print("office update: the lock is held across the move to the new release")
h = Home()
kit(h, gh_axi="0.1.30")
tip = h.upstream(h.root / "office.git", bump("0.1.36"))
# herdr --version is asked while each release plans: this says whether the lock was held then
watch = h.bin / "lockwatch"
watch.write_text(f"""#!{sys.executable}
import fcntl, os, subprocess
home = os.environ["HOME"]
try:
    f = open(home + "/.local/state/agent-office/update.lock")
    try:
        fcntl.flock(f, fcntl.LOCK_SH | fcntl.LOCK_NB)
        r = "free"
    except OSError:
        r = "held"
except OSError:
    r = "none"
head = subprocess.run(["git", "-C", home + "/agent-office", "rev-parse", "HEAD"], capture_output=True, text=True)
open({str(h.log)!r}, "a").write("lockwatch " + r + " " + head.stdout.strip() + "\\n")
""")
watch.chmod(0o755)
r = h.run("--yes")
seen = [c.split()[1] for c in h.calls() if c.startswith("lockwatch ") and c.endswith(tip)]
check("the new release planned while the lock was still held, and then finished", r.returncode == 0 and seen
      and set(seen) == {"held"} and rows(r.stdout.split("Results:")[-1]).get("gh-axi") == "updated: 0.1.30 -> 0.1.36",
      r.stdout + r.stderr + str(h.calls()))
r = h.run("--yes")
check("and it let go of it at the end: the next run takes it", r.returncode == 0 and "another office update" not in r.stderr,
      r.stdout + r.stderr)
h.done()

print("PASS" if not fails else f"FAIL: {fails}")
sys.exit(1 if fails else 0)
