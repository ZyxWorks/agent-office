# Firstmate's own updater, when the checkout has one: a stand-in that fast-forwards like the real
# one and says what it was given
h = Home()
kit(h)
updater = h.fm / "bin" / "fm-update.sh"
updater.parent.mkdir()
# what it reports past its own fast-forward is in ~/fm-said, one line each, ERR: for stderr
updater.write_text(f'#!/bin/sh\necho "fm-update FM_HOME=$FM_HOME" >> {h.log}\n'
                   'git fetch -q origin && git merge -q --ff-only origin/main\n'
                   '[ -f "$HOME/fm-said" ] && while IFS= read -r l; do\n'
                   '  case $l in ERR:*) echo "${l#ERR:}" >&2 ;; *) echo "$l" ;; esac; done < "$HOME/fm-said"\n'
                   'echo "reread-firstmate: yes"\n')
updater.chmod(0o755)
h.git(h.fm, "add", "-A")
h.git(h.fm, "commit", "-qm", "an updater")
h.git(h.fm, "push", "-q", "origin", "main")
old = h.git(h.fm, "rev-parse", "HEAD")
new = h.upstream(h.root / "fm.git", touch)
m = h.office / "config" / "components.toml"
m.write_text(re.sub(r'\[firstmate\]\ntested = \[.*\]', f'[firstmate]\ntested = ["{"0" * 40}"]\nupdate = "bin/fm-update.sh"',
                    m.read_text()))
# the registry its updater sweeps: one secondmate here, one on another host, one line it cannot read
reg = h.home / "fm-home" / "data" / "secondmates.md"
reg.parent.mkdir()
reg.write_text("# Secondmates\n"
               "- web - Runs the web work. (home: /srv/homes/web; scope: web; projects: site; added 2026-10-01)\n"
               "- far - Runs the far work. (host: buildbox; root: /srv/fm; home: /srv/fm-far; scope: far; projects: a; "
               "added 2026-10-02)\n"
               "- broken entry\n")
r = h.run("--check")
check("secondmates registered, but this Firstmate has no parser for them: unknown, not none",
      "secondmates: unknown: ~/fm-home/data/secondmates.md lists them, but this Firstmate has no "
      "bin/fm-secondmate-registry-lib.sh to read it with" in under(r.stdout, "firstmate"), r.stdout)
# a stand-in for Firstmate's own parser, with its function and the fields it sets
(h.fm / "bin" / "fm-secondmate-registry-lib.sh").write_text(r'''
secondmate_registry_parse_line() {
  local here='^- ([a-z]+) - .*\(home: ([^;]*);' far='^- ([a-z]+) - .*\(host: ([^;]*); root: [^;]*; home: ([^;]*);'
  SECONDMATE_REGISTRY_REMOTE=0 SECONDMATE_REGISTRY_HOST=
  if [[ "$1" =~ $here ]]; then
    SECONDMATE_REGISTRY_ID=${BASH_REMATCH[1]} SECONDMATE_REGISTRY_HOME=${BASH_REMATCH[2]}
  elif [[ "$1" =~ $far ]]; then
    SECONDMATE_REGISTRY_ID=${BASH_REMATCH[1]} SECONDMATE_REGISTRY_HOST=${BASH_REMATCH[2]}
    SECONDMATE_REGISTRY_HOME=${BASH_REMATCH[3]} SECONDMATE_REGISTRY_REMOTE=1
  else
    return 1
  fi
}
''')
r = h.run("--check")
for want in ("secondmates: Firstmate's own updater moves these 2 with it", "web: this machine, /srv/homes/web",
             "far: on the host buildbox, home /srv/fm-far",
             "and 1 line(s) of ~/fm-home/data/secondmates.md that Firstmate's parser cannot read, so its updater skips them"):
    check(f"the remote Firstmate scope, read with Firstmate's parser: {want[:50]}", want in under(r.stdout, "firstmate"), r.stdout)
check("its own updater goes to the newest commit: not tested, so it is not run",
      f"blocker: its own updater goes to the newest commit of its source, {new[:12]}, which is not a revision this "
      "release is tested with" in under(r.stdout, "firstmate"), r.stdout)
m.write_text(m.read_text().replace("0" * 40, new))
r = h.run("--check")
check("tested: the plan is Firstmate's own updater, with its home", "runs: FM_HOME=~/fm-home ~/firstmate/bin/fm-update.sh"
      in under(r.stdout, "firstmate") and re.search(r"Firstmate's own updater \(bin/fm-update\.sh\)", r.stdout), r.stdout)
check("and its secondmates restart too, as Firstmate's updater names them",
      "and each live secondmate it lists in restart-secondmates or nudge-secondmates" in under(r.stdout, "firstmate"), r.stdout)
(h.home / "herdr-status.json").write_text(json.dumps({"running": True, "version": "0.9.1", "socket": "/x/s.sock"}) + "\n")
(h.home / "fm-said").write_text(f"firstmate: updated {old[:7]}..{new[:7]}\n"
                                "secondmate web: updated 1111111..2222222\n"
                                "ERR:remote secondmate far: skipped on buildbox: ssh: connect to host buildbox: timed out\n"
                                "ERR:secondmate registry: skipped malformed entry: - broken entry\n"
                                "restart-secondmates: fm-web\nnudge-secondmates: none\n")
r = h.run("--yes")
got = rows(r.stdout.split("Results:")[-1])
res = r.stdout.split("Results:")[-1]
check("each secondmate its updater moved has its own result: a live one is on disk, not active, with its restart",
      re.search(r"  pending +secondmate web +1111111\.\.2222222 on disk, not yet active: it still runs the old instructions\. "
                r"`FM_HOME=~/fm-home ~/firstmate/bin/fm-secondmate-restart\.sh fm-web` restarts it, as Firstmate's "
                r"/updatefirstmate does", res), r.stdout)
check("one it skipped is skipped, with its reason from stderr, and so are the registry lines it cannot read",
      re.search(r"  skipped +secondmate far +on buildbox: ssh: connect to host buildbox: timed out", res)
      and re.search(r"  skipped +secondmate registry +1 line\(s\) Firstmate's parser cannot read", res), r.stdout)
check("it restarted no secondmate itself", not any("fm-secondmate-restart" in c or "fm-send" in c for c in h.calls()),
      str(h.calls()))
check("it ran with FM_HOME, and the checkout is at the tested revision",
      f"fm-update FM_HOME={h.home / 'fm-home'}" in h.calls() and h.git(h.fm, "rev-parse", "HEAD") == new, str(h.calls()))
check("while the office session runs it is on disk, not active: the command is fm restart",
      r.returncode == 1 and re.match(r"pending: \w{12} -> \w{12} on disk, not yet active: a running Firstmate keeps the "
                                     r"instructions it started with: `fm restart`", got.get("firstmate", "")), r.stdout)
(h.home / "fm-said").write_text("remote secondmate far: already current on buildbox (2222222)\nrestart-secondmates: none\n")
n = len(h.calls())
r = h.run("--check")
check("the next plan runs its updater again, for the secondmate it skipped, not for the registry lines",
      "runs: FM_HOME=~/fm-home ~/firstmate/bin/fm-update.sh, again: last time it skipped secondmate far" in
      under(r.stdout, "firstmate"), r.stdout)
r = h.run("--yes")
res = r.stdout.split("Results:")[-1]
check("and the run picks it up: Firstmate unchanged, the secondmate at its target",
      [c for c in h.calls()[n:] if c.startswith("fm-update")] == [f"fm-update FM_HOME={h.home / 'fm-home'}"]
      and re.search(rf"  unchanged +firstmate +{new[:12]}; its updater ran again for its secondmates", res)
      and re.search(r"  unchanged +secondmate far +on buildbox \(2222222\)", res), r.stdout + str(h.calls()[n:]))
n = len(h.calls())
r = h.run("--yes")
check("then nothing is left for it: its updater does not run again",
      not [c for c in h.calls()[n:] if c.startswith("fm-update")]
      and re.search(r"  unchanged +firstmate +" + new[:12] + r"\n", r.stdout), r.stdout + str(h.calls()[n:]))
h.done()

