#!/usr/bin/env python3
"""update-probe: `office update` and `office update --check`, each in a throwaway $HOME.

Never your own home, never the network and never this machine's tools. Every case gets a fresh
folder as HOME holding a copy of this checkout with a git remote of its own, a stand-in Firstmate
checkout with its remote, and a PATH of fakes only: herdr, brew, npm, node and curl are scripts
that write down how they were called, and git is the one real program. So an update here can
only ever move the copy, and no herdr server is asked anything. Each case is a promise the
README makes.

  bin/update-probe
  /usr/bin/python3 bin/update-probe     # macOS: also proves Python 3.9 and the vendored reader
"""

import fcntl
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO / "lib"))
from agent_office import tools  # noqa: E402
from agent_office.cli import VERSION as CLI_VERSION  # noqa: E402

PLAT = tools.platform_key()
GIT = shutil.which("git")
fails = 0


def check(name, ok, detail=""):
    global fails
    print(f"  {'ok  ' if ok else 'FAIL'} {name}" + ("" if ok or not detail else f"\n       {detail}"))
    fails += 0 if ok else 1


LINK = (
    'import json,os,re,sys;root=sys.argv[1];t=open(root+"/herdr-plugin.toml").read();'
    'ids=re.findall(r"^id = \\"(.*)\\"$",t,re.M);v=re.search(r"^version = \\"(.*)\\"$",t,re.M).group(1);'
    'd=os.path.expanduser("~/.config/herdr");os.makedirs(d,exist_ok=True);'
    'json.dump([dict(plugin_id=ids[0],plugin_root=root,version=v,enabled=True,'
    'actions=[dict(id=i) for i in ids[1:]])],open(d+"/plugins.json","w"))')


def herdr_text(version, log):
    """A herdr that answers what office asks and writes down every call, so a test can prove
    that `herdr update` and `herdr server stop` were never among them."""
    return (f'#!/bin/sh\necho "herdr $*" >> {log}\n'
            '[ "$1" = --version ] && [ -x "$HOME/fakebin/lockwatch" ] && "$HOME/fakebin/lockwatch"\n'
            f'[ "$1" = --version ] && {{ echo "herdr {version}"; exit 0; }}\n'
            '[ "$1 $2" = "config check" ] && exit 0\n'
            '[ "$1 $3 $4" = "--session status server" ] && {  # no cat: PATH is only the fakes\n'
            '  read -r s <"$HOME/herdr-status.json" 2>/dev/null ||\n'
            '  s=\'{"status":"not_running","running":false,"socket":"/x/herdr.sock"}\'; echo "$s"; exit 0; }\n'
            # `plugin link <folder>`: what herdr records in its plugins.json, from the manifest
            f'[ "$1 $2" = "plugin link" ] && exec {sys.executable} -c \'{LINK}\' "$3"\n'
            'exit 1\n')


class Home:
    def __init__(self):
        self.root = Path(tempfile.mkdtemp(prefix="office-update-probe."))
        self.home = self.root / "home"
        self.bin = self.home / "fakebin"
        self.bin.mkdir(parents=True)
        self.log = self.root / "calls.log"
        self.state = self.home / ".local" / "state" / "agent-office"
        self.record = self.state / "update.json"
        self.office = self.home / "agent-office"
        self.fm = self.home / "firstmate"
        os.symlink(GIT, self.bin / "git")
        os.symlink(shutil.which("bash") or "/bin/bash", self.bin / "bash")   # Firstmate's parser runs in it

    def env(self, **extra):
        env = {k: v for k, v in os.environ.items()
               if not k.startswith(("XDG_", "HERDR_", "GIT_", "FM_")) and k != "ZDOTDIR"}
        env.update(HOME=str(self.home), PYTHONDONTWRITEBYTECODE="1",
                   PATH=f"{self.bin}:{self.home / '.local' / 'bin'}", **extra)
        return env

    def run(self, *args):
        # the copy's own office, so "this checkout" is the copy; no terminal, so nothing can ask
        return subprocess.run([sys.executable, str(self.office / "bin" / "office"), "update", *args],
                              env=self.env(), capture_output=True, text=True, stdin=subprocess.DEVNULL,
                              start_new_session=True)

    def git(self, where, *args):
        r = subprocess.run([GIT, "-C", str(where), "-c", "user.name=probe", "-c", "user.email=probe@example.invalid",
                            "-c", "commit.gpgsign=false", *args], env=self.env(), capture_output=True, text=True)
        if r.returncode != 0:
            sys.exit(f"update-probe: git {' '.join(args)} failed in {where}: {r.stderr}")
        return r.stdout.strip()

    def snapshot(self):
        out = {}
        for p in sorted(self.home.rglob("*")):
            if p.is_symlink():
                out[str(p)] = "-> " + os.readlink(p)
            elif p.is_file():
                out[str(p)] = hashlib.sha256(p.read_bytes()).hexdigest()
        return out

    def calls(self):
        return self.log.read_text().splitlines() if self.log.exists() else []

    def fake(self, name, body):
        p = self.bin / name
        p.write_text("#!/bin/sh\n" + body + "\n")
        p.chmod(0o755)

    def program(self, path, version, linked=True):
        """A fake program at path under the home, where its owner would put it, linked like an
        install. It writes down its calls: a self-updater must never be asked to update."""
        real = self.home / path
        real.parent.mkdir(parents=True, exist_ok=True)
        real.write_text(herdr_text(version, self.log) if real.name == "herdr" else
                        f'#!/bin/sh\necho "{real.name} $*" >> {self.log}\necho "{version}"\n')
        real.chmod(0o755)
        link = self.bin / real.name.split(".")[0]
        if linked and link != real:
            os.symlink(real, link)

    def repo(self, where, bare):
        """Make where a git checkout that follows its own remote, a bare repo outside the home."""
        self.git(where, "init", "-q", "-b", "main")
        self.git(where, "add", "-A")
        self.git(where, "commit", "-q", "--allow-empty", "-m", "first")
        subprocess.run([GIT, "clone", "-q", "--bare", str(where), str(bare)], env=self.env(), check=True)
        self.git(where, "remote", "add", "origin", str(bare))
        self.git(where, "fetch", "-q", "origin")
        self.git(where, "branch", "-q", "-u", "origin/main")
        return self.git(where, "rev-parse", "HEAD")

    def upstream(self, bare, edit):
        """A commit on the remote that the checkout does not have yet. Its hash."""
        work = self.root / "work"
        if work.exists():
            shutil.rmtree(work)
        subprocess.run([GIT, "clone", "-q", str(bare), str(work)], env=self.env(), check=True)
        edit(work)
        self.git(work, "add", "-A")
        self.git(work, "commit", "-q", "-m", "next")
        self.git(work, "push", "-q", "origin", "main")
        return self.git(work, "rev-parse", "HEAD")

    def done(self):
        shutil.rmtree(self.root)


def asset(h, name, text, tar_as=None):
    prog = h.root / "assets" / (tar_as or name)
    prog.parent.mkdir(exist_ok=True)
    prog.write_text(text)
    if not tar_as:
        return hashlib.sha256(prog.read_bytes()).hexdigest()
    out = h.root / "assets" / name
    with tarfile.open(out, "w:gz") as tar:
        tar.add(prog, arcname=tar_as)
    return hashlib.sha256(out.read_bytes()).hexdigest()


ODD = '''
[[component]]
name = "chrome-devtools-axi"
command = "chrome-devtools-axi"
npm = "chrome-devtools-axi"
pin = "0.1.35"
node = "20"
[[component]]
name = "lavish-axi"
command = "lavish-axi"
npm = "lavish-axi"
pin = "0.1.79"
node = "20"
[[component]]
name = "gnhf"
command = "gnhf"
npm = "gnhf"
pin = "0.1.50"
node = "20"
[[component]]
name = "backpass"
command = "backpass"
npm = "backpass"
pin = "0.1.28"
node = "20"
'''


def manifest(h, tested, odd=False, fm_update=None):
    """One tool of each owner kind, at the pins this probe's fakes install."""
    herdr = asset(h, "herdr-test", herdr_text("0.9.1", h.log))
    nm = asset(h, "nm-test.tar.gz", '#!/bin/sh\necho "no-mistakes version v1.84.0"\n', tar_as="no-mistakes")
    return f'''schema = 1
[[component]]
name = "herdr"
command = "herdr"
update = "herdr update"
tested = ["0.9.1"]
pin = "0.9.1"
[component.release]
url = "https://example.invalid/"
dir = "~/.local/bin"
{PLAT} = {{ asset = "herdr-test", sha256 = "{herdr}" }}
[[component]]
name = "treehouse"
command = "treehouse"
update = "treehouse update"
pin = "3.1.0"
[[component]]
name = "no-mistakes"
command = "no-mistakes"
update = "no-mistakes update"
restart = "no-mistakes daemon restart"
pin = "1.84.0"
[component.release]
url = "https://example.invalid/"
dir = "~/.no-mistakes/bin"
link = "~/.local/bin"
{PLAT} = {{ asset = "nm-test.tar.gz", sha256 = "{nm}" }}
[[component]]
name = "jq"
command = "jq"
brew = "jq"
[[component]]
name = "gh-axi"
command = "gh-axi"
npm = "gh-axi"
pin = "0.1.35"
node = "20"
[[component]]
name = "quota-axi"
command = "quota-axi"
npm = "quota-axi"
pin = "0.1.55"
node = "22.19"
{ODD if odd else ""}
[[component]]
name = "ripgrep"
command = "rg"
brew = "ripgrep"
profile = "workstation"
[[harness]]
name = "claude"
command = "claude"
update = "claude update"
[[harness]]
name = "codex"
command = "codex"
[firstmate]
tested = [{", ".join(f'"{t}"' for t in tested)}]
{f'update = "{fm_update}"' if fm_update else ""}
'''


def kit(h, odd=False, **have):
    """A home with every tool where its owner puts it, at its target unless have says otherwise,
    a Firstmate checkout and a copy of this checkout, each following a remote of its own."""
    v = {"herdr": "0.9.1", "treehouse": "3.1.0", "nm": "1.84.0", "gh_axi": "0.1.35", **have}
    h.program(".local/bin/herdr", v["herdr"], linked=False)              # itself, where its installer puts it
    h.program("brew/Cellar/treehouse/3.0.0/bin/treehouse", v["treehouse"])   # Homebrew's, though it can self-update
    h.program(".no-mistakes/bin/no-mistakes", f"no-mistakes version v{v['nm']}", linked=False)
    os.symlink(h.home / ".no-mistakes" / "bin" / "no-mistakes", h.home / ".local" / "bin" / "no-mistakes")
    h.program("brew/Cellar/jq/1.8.2/bin/jq", "jq-1.8.2")
    h.program("node/lib/node_modules/gh-axi/dist/bin/gh-axi.js", v["gh_axi"])
    h.program("node/lib/node_modules/quota-axi/dist/bin/quota-axi.js", "0.1.55")
    h.program(".claude/local/claude", "2.1.0")                          # the harness: claude, the default
    if odd:
        h.program("node/lib/node_modules/chrome-devtools-axi/dist/bin/chrome-devtools-axi.js", "0.1.30")
        h.program("node/lib/node_modules/lavish-axi/dist/bin/lavish-axi.js", "9.9.9")     # newer than the pin
        h.program("fakebin/gnhf", "0.1.40")                                                # nobody owns it
        (h.root / "npm-fail-chrome-devtools-axi").write_text("")                           # backpass: missing
    h.fake("node", "echo v24.1.0")
    # npm installs the version after the @, unless a test made it fail or die for that package
    h.fake("npm", f'echo "npm $*" >> {h.log}\nfor a; do :; done\nn=${{a%@*}}; v=${{a#*@}}\n'
           f'[ -e {h.root}/npm-fail-$n ] && {{ echo "npm error 404 $a is not in this registry" >&2; exit 1; }}\n'
           f'[ -e {h.root}/npm-kill-$n ] && {{ kill -9 $PPID; exit 1; }}\n'
           f'printf \'#!/bin/sh\\necho %s\\n\' "$v" > {h.home}/node/lib/node_modules/$n/dist/bin/$n.js')
    # brew says which version it has, and upgrades to exactly that
    h.fake("brew", f'echo "brew $*" >> {h.log}\nfor a; do :; done\nread -r v < {h.root}/brew-has-$a || exit 1\n'
           '[ "$1" = info ] && { echo "{\\"formulae\\":[{\\"versions\\":{\\"stable\\":\\"$v\\"}}],\\"casks\\":[]}"; exit 0; }\n'
           f'[ "$1" = upgrade ] && printf \'#!/bin/sh\\necho %s\\n\' "$v" > {h.bin}/$a')
    (h.root / "brew-has-treehouse").write_text("3.1.0\n")
    # curl saves the asset from a local folder: the URL in the manifest is never reached
    h.fake("curl", f'echo "curl $*" >> {h.log}\nwhile [ $# -gt 1 ]; do [ "$1" = -o ] && d=$2; shift; done\n'
           f'/bin/cp {h.root}/assets/${{1##*/}} "$d"')

    h.fm.mkdir()
    (h.fm / "AGENTS.md").write_text("one\n")
    rev = h.repo(h.fm, h.root / "fm.git")
    (h.home / "fm-home").mkdir()
    cfg = h.home / ".config" / "agent-office" / "config.toml"
    cfg.parent.mkdir(parents=True)
    cfg.write_text(f'schema = 1\n[firstmate]\nsource = "{h.root / "fm.git"}"\ncode = "~/firstmate"\nhome = "~/fm-home"\n')

    for d in ("bin", "lib", "config", "preset", "herdr"):
        shutil.copytree(REPO / d, h.office / d, ignore=shutil.ignore_patterns("__pycache__"))
    (h.office / "config" / "components.toml").write_text(manifest(h, [rev], odd))
    h.repo(h.office, h.root / "office.git")
    return rev


def rows(said):
    """The plan or the results as {name: the rest of its line}."""
    out = {}
    for line in said.splitlines():
        m = re.match(r"  (update|blocked|ok|updated|unchanged|skipped|failed|pending) +(\S+) +(.*)", line)
        if m:
            out[m.group(2)] = f"{m.group(1)}: {m.group(3)}"
    return out


def under(said, name):
    """The lines the plan prints under one component: what runs, what restarts, what blocks."""
    lines = said.splitlines()
    i = next((n for n, l in enumerate(lines) if re.match(rf"  \w+ +{re.escape(name)} ", l)), None)
    out = []
    for l in lines[i + 1:] if i is not None else []:
        if not l.startswith("     "):
            break
        out.append(l.strip())
    return "\n".join(out)


def kept_at(cmd):
    """What a result adds when the program a release asset replaced is kept, as a pattern."""
    return re.escape(f" (the program it replaced is kept at ~/.local/state/agent-office/previous/{cmd})")


def bump(pin):
    def edit(work):
        m = work / "config" / "components.toml"
        m.write_text(m.read_text().replace('pin = "0.1.35"\nnode = "20"\n[[component]]\nname = "quota-axi"',
                                           f'pin = "{pin}"\nnode = "20"\n[[component]]\nname = "quota-axi"'))
    return edit


def touch(work):
    (work / "AGENTS.md").write_text("two\n")


if not GIT:
    sys.exit("update-probe: needs git on PATH")

print("office update --check: a plan, and nothing written")
h = Home()
kit(h, odd=True, herdr="0.9.0", treehouse="3.0.0", nm="1.83.0", gh_axi="0.1.30")
fm_old = h.git(h.fm, "rev-parse", "HEAD")
fm_new = h.upstream(h.root / "fm.git", touch)
m = h.office / "config" / "components.toml"                    # this release is tested with the new Firstmate
m.write_text(m.read_text().replace(f'tested = ["{fm_old}"]', f'tested = ["{fm_new}"]'))
h.git(h.office, "commit", "-qam", "tested")
h.git(h.office, "push", "-q", "origin", "main")
tip = h.upstream(h.root / "office.git", bump("0.1.36"))       # the next release pins a newer gh-axi
before = h.snapshot()
r = h.run("--check")
said = r.stdout
check("exit 0", r.returncode == 0, said + r.stderr)
check("it wrote nothing: every file in the home, both .git folders too, hashes the same", h.snapshot() == before)
check("it ran no updater: no npm, brew or curl, and herdr was only asked for its version and status",
      not [c for c in h.calls() if not re.fullmatch(r"herdr (--version|--session office status server --json)|\S+ --version", c)],
      str(h.calls()))
plan = rows(said)
for name, want in (("agent-office", rf"update: \w{{12}} +{tip[:12]} +git, origin/main"),
                   ("herdr", r"update: 0\.9\.0 +0\.9\.1 +itself \(herdr update\)"),
                   ("treehouse", r"update: 3\.0\.0 +3\.1\.0 +Homebrew \(treehouse\)"),
                   ("no-mistakes", r"update: 1\.83\.0 +1\.84\.0 +itself \(no-mistakes update\)"),
                   # the release it moves to pins 0.1.36, and that release is what applies the rest
                   ("gh-axi", r"update: 0\.1\.30 +0\.1\.36 +npm, global \(gh-axi\)"),
                   ("quota-axi", r"ok: 0\.1\.55 +0\.1\.55 +npm, global \(quota-axi\)"),
                   ("firstmate", rf"update: {fm_old[:12]} +{fm_new[:12]} +git, origin \(firstmate\.source\)"),
                   ("config", rf"update: 7 file\(s\) behind +release {tip[:12]} +office install")):
    check(f"{name}: installed, target, owner", re.fullmatch(want, plan.get(name, "")), said)
check("one target set: the targets are the release the checkout moves to",
      f"Targets: the release at {tip[:12]} (office " in said, said)
check("no temporary repository is left behind", not list(Path(tempfile.gettempdir()).glob("office-update.*")))
for name, want in (
        ("agent-office", f"runs: git fetch origin refs/heads/main, then git merge --ff-only {tip[:12]}, in ~/agent-office"),
        ("herdr", "runs: its release asset herdr-test at 0.9.1, SHA-256 checked, over ~/.local/bin/herdr "
                  "(`herdr update` takes no version, so it is not run)"),
        ("herdr", "restart: a running herdr server"),
        ("treehouse", "runs: brew upgrade --formula treehouse, when Homebrew has 3.1.0 (asked first)"),
        ("no-mistakes", "runs: its release asset nm-test.tar.gz at 1.84.0, SHA-256 checked, over ~/.no-mistakes/bin/no-mistakes"),
        ("no-mistakes", "restart: `no-mistakes daemon restart`, for what already runs"),
        ("agent-office", "restart: nothing: the next office command runs the new release"),
        ("agent-office", "cli: office 1.0.0-dev, the same version"),
        ("agent-office", "preset: unchanged"),
        ("herdr", "(the session office is not running, so nothing old runs)"),
        ("gh-axi", "runs: npm install -g --ignore-scripts gh-axi@0.1.36"),
        ("gh-axi", "restart: nothing, the next run uses it"),
        ("firstmate", f"runs: git fetch origin, then git merge --ff-only {fm_new[:12]}, in ~/firstmate"),
        ("firstmate", "restart: a running Firstmate: `fm restart`"),
        ("firstmate", "secondmates: none registered, so only this checkout moves"),
        ("config", "runs: office install --yes, as the release Agent Office moves to writes it"),
        ("backpass", "blocker: backpass is not on PATH: `office tools` installs it"),
        ("gnhf", "blocker: nothing says how ~/fakebin/gnhf is updated (owner unknown)"),
        ("lavish-axi", "blocker: 9.9.9 is newer than the target 0.1.79: Agent Office never downgrades")):
    check(f"{name}: {want[:70]}", want in under(said, name), said)
check("a tool with no pin is left to its owner, your harness too; a workstation tool you lack is not missed",
      "no version pinned, so their owner decides: jq, claude" in said and "ripgrep" not in said
      and "codex" not in said, said)
check("your home is never printed", str(h.home) not in said + r.stderr, said)

print("office update: asks first")
r = h.run()
check("without a terminal or --yes it refuses and changes nothing",
      r.returncode == 1 and "not confirmed" in r.stderr and h.snapshot() == before, r.stdout + r.stderr)

print("office update: each component through its owner, each result as it is")
r = h.run("--yes")
said = r.stdout
got = rows(said.split("Results:")[-1])
check("a failed component makes it exit 1", r.returncode == 1, said + r.stderr)
check("this checkout was fast-forwarded to the commit the plan showed",
      h.git(h.office, "rev-parse", "HEAD") == tip and "Agent Office itself moved" in said, said)
for name, want in (("agent-office", r"updated: \w{12} -> " + tip[:12] + r" \(earlier in this update\)"),
                   ("herdr", r"updated: 0\.9\.0 -> 0\.9\.1" + kept_at("herdr")),
                   ("treehouse", r"updated: 3\.0\.0 -> 3\.1\.0"),
                   ("no-mistakes", r"pending: 1\.83\.0 -> 1\.84\.0" + kept_at("no-mistakes") + r" on disk, not yet active: what already runs keeps "
                                   r"1\.83\.0 until you run `no-mistakes daemon restart`"),
                   ("gh-axi", r"updated: 0\.1\.30 -> 0\.1\.36"),
                   ("quota-axi", r"unchanged: 0\.1\.55"),
                   ("chrome-devtools-axi", r"failed: `npm install -g --ignore-scripts chrome-devtools-axi@0\.1\.35` failed \(exit 1\)"),
                   ("lavish-axi", r"skipped: 9\.9\.9 is newer than the target .*"),
                   ("gnhf", r"skipped: nothing says how ~/fakebin/gnhf is updated \(owner unknown\)"),
                   ("backpass", r"skipped: backpass is not on PATH.*"),
                   ("firstmate", rf"updated: {fm_old[:12]} -> {fm_new[:12]}"),
                   ("config", r"updated: written by office install")):
    check(f"{name}: {want[:60]}", re.fullmatch(want, got.get(name, "")), said)
check("and the counts", "6 updated, 4 unchanged, 3 skipped, 1 failed, 1 updated on disk but not yet active." in said, said)
calls = h.calls()
check("the rest ran from the new release: npm got its pin, not the old one",
      "npm install -g --ignore-scripts gh-axi@0.1.36" in calls and not any("gh-axi@0.1.35" in c for c in calls), str(calls))
check("Homebrew was asked what it has, then upgraded", [c for c in calls if c.startswith("brew")] == [
    "brew info --json=v2 --formula treehouse", "brew upgrade --formula treehouse"], str(calls))
check("a self-updater is never run next to its owner, and herdr is never stopped or reloaded",
      not any(re.search(r"^(herdr|treehouse|no-mistakes) .*\b(update|stop|reload-config)\b", c) for c in calls
              if not c.startswith("herdr plugin link ")), str(calls))  # its path may hold any word
check("the release assets came through curl, and only those", [c.rsplit("/", 1)[1] for c in calls if c.startswith("curl")]
      == ["herdr-test", "nm-test.tar.gz"], str(calls))
check("Firstmate was fast-forwarded to the tested revision", h.git(h.fm, "rev-parse", "HEAD") == fm_new)
check("the config is written", (h.state / "herdr" / "config.toml").is_file())
rec = json.loads(h.record.read_text())
check("the record says done, exit 1, and each result",
      rec["state"] == "done" and rec["exit"] == 1 and rec["results"]["chrome-devtools-axi"]["state"] == "failed", str(rec))
(h.root / "npm-fail-chrome-devtools-axi").unlink()
n = len(h.calls())
r = h.run("--yes")
got = rows(r.stdout.split("Results:")[-1])
check("a second run does only what is left", got.get("chrome-devtools-axi") == "updated: 0.1.30 -> 0.1.35"
      and [c for c in h.calls()[n:] if not re.search(r"--version|status server", c)]
      == ["npm install -g --ignore-scripts chrome-devtools-axi@0.1.35"], r.stdout + str(h.calls()[n:]))
check("what is still skipped still makes it exit 1", r.returncode == 1 and "3 skipped" in r.stdout, r.stdout)
r = h.run("--bogus")
check("an unknown option is refused", r.returncode == 2 and "unknown option --bogus" in r.stderr, r.stderr)
h.done()

