print("office update --check: the CLI, preset and meter move as one release")
h = Home()
kit(h, gh_axi="0.1.30")
plugin = h.office / "herdr" / "herdr-plugin.toml"
meter = re.search(r'^version = "(.*)"$', plugin.read_text(), re.M).group(1)


def release(work):
    for f, pat, new in (("lib/agent_office/cli.py", r'^VERSION = ".*"$', 'VERSION = "9.9.9"'),
                        ("herdr/herdr-plugin.toml", r'^version = ".*"$', 'version = "9.9.1"')):
        (work / f).write_text(re.sub(pat, new, (work / f).read_text(), count=1, flags=re.M))
    (work / "preset" / "herdr" / "config.toml").write_text((work / "preset" / "herdr" / "config.toml").read_text() + "# next\n")


tip = h.upstream(h.root / "office.git", release)
(h.home / "herdr-status.json").write_text(json.dumps({"running": True, "version": "0.9.1", "socket": "/x/s.sock"}) + "\n")
r = h.run("--check")
part = under(r.stdout, "agent-office")
check("the targets are the new release's", f"Targets: the release at {tip[:12]} (office 9.9.9)" in r.stdout, r.stdout)
for want in (f"cli: office {CLI_VERSION} -> 9.9.9",
             "preset: 1 file(s) change: preset/herdr/config.toml; office install writes the herdr config from it",
             f"meter: {meter} -> 9.9.1, 1 file(s) change: herdr/herdr-plugin.toml",
             "restart: the herdr config and the meter of a running office session (the session office runs now, on herdr 0.9.1)"):
    check(f"agent-office: {want[:60]}", want in part, r.stdout)
check("a running session is named where a restart of it activates the update",
      "(the session office runs now, on herdr 0.9.1)" in under(r.stdout, "config"), r.stdout)
# the move fails: git cannot take the index lock, so the checkout stays on this release
(h.office / ".git" / "index.lock").write_text("")
n = len(h.calls())
r = h.run("--yes")
got = rows(r.stdout.split("Results:")[-1])
check("when Agent Office does not move, nothing planned from the new release is applied", r.returncode == 1
      and got.get("agent-office", "").startswith("failed: ")
      and got.get("gh-axi") == "skipped: planned from the release Agent Office was to move to, which it did not: run office "
                               "update again"
      and not [c for c in h.calls()[n:] if c.startswith(("npm", "curl", "brew"))], r.stdout + str(h.calls()[n:]))
h.done()

print("office update: a checkout that cannot be fast-forwarded blocks, and only itself")
h = Home()
kit(h)
tip = h.upstream(h.root / "office.git", bump("0.1.36"))
(h.office / "bin" / "office").write_text((h.office / "bin" / "office").read_text() + "# mine\n")
r = h.run("--check")
check("dirty: uncommitted changes block it, and it says the update does not touch them", r.returncode == 0
      and "blocker: 1 tracked file(s) in ~/agent-office have uncommitted changes (dirty); the update changes none "
          "of them: bin/office." in under(r.stdout, "agent-office"), r.stdout)
