      and "blocker: it has commits the target does not have (diverged)" in under(r.stdout, "agent-office"), r.stdout)
r = h.run("--yes")
check("applying skips it, exit 1, and the checkout is where it was", r.returncode == 1
      and rows(r.stdout.split("Results:")[-1]).get("agent-office", "").startswith("skipped: it has commits")
      and h.git(h.office, "rev-parse", "HEAD") == head, r.stdout + r.stderr)
check("the others' results are all there", len(rows(r.stdout.split("Results:")[-1])) == 10, r.stdout)
h.git(h.office, "remote", "set-url", "origin", str(h.root / "gone.git"))
r = h.run("--check")
check("offline is reported, not a crash", r.returncode == 0 and "Traceback" not in r.stderr
      and "blocker: the remote origin did not answer (offline?)" in under(r.stdout, "agent-office"), r.stdout + r.stderr)
r = h.run("--yes")
check("and applying skips it", r.returncode == 1
      and "skipped    agent-office  the remote origin did not answer" in r.stdout, r.stdout + r.stderr)
h.done()

