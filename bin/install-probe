#!/usr/bin/env python3
"""install-probe: `office install` and `office config`, each in a throwaway $HOME.

Never your own home: every run gets a fresh folder as HOME, with XDG_* and ZDOTDIR cleared, and
runs in its own session so it has no terminal to ask on (the way CI and a pipe meet it). It needs
`herdr` on PATH, because install asks herdr to check the config it generates; no herdr server is
touched. Each case below is a promise the README or CONTRIBUTING makes.

  bin/install-probe
  /usr/bin/python3 bin/install-probe     # macOS: also proves Python 3.9 and the vendored reader
"""

import hashlib
import io
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
OFFICE = REPO / "bin" / "office"
fails = 0


def check(name, ok, detail=""):
    global fails
    print(f"  {'ok  ' if ok else 'FAIL'} {name}" + ("" if ok or not detail else f"\n       {detail}"))
    fails += 0 if ok else 1


class Home:
    def __init__(self):
        self.root = Path(tempfile.mkdtemp(prefix="office-install-probe."))
        self.home = self.root / "home"
        self.home.mkdir()
        self.cfg = self.home / ".config" / "agent-office" / "config.toml"
        self.state = self.home / ".local" / "state" / "agent-office"
        self.gen = self.state / "herdr" / "config.toml"
        self.link = self.home / ".local" / "bin" / "office"

    def env(self, **extra):
        env = {k: v for k, v in os.environ.items()
               if not k.startswith("XDG_") and k not in ("ZDOTDIR", "HERDR_CONFIG_PATH")}
        env.update(HOME=str(self.home), PYTHONDONTWRITEBYTECODE="1", **extra)
        return env

    def run(self, *args, cmd=None, **extra):
        env = self.env(**extra)
        # start_new_session: no controlling terminal, so a question can never block the probe
        # this probe's own Python runs office too, so `/usr/bin/python3 bin/install-probe` on macOS
        # (3.9, no tomllib) tests the vendored TOML reader
        return subprocess.run([sys.executable, str(cmd or OFFICE), *args], env=env, capture_output=True, text=True,
                              stdin=subprocess.DEVNULL, start_new_session=True)

    def snapshot(self):
        out = {}
        for p in sorted(self.home.rglob("*")):
            if p.is_symlink():
                out[str(p)] = "-> " + os.readlink(p)
            elif p.is_file():
                out[str(p)] = hashlib.sha256(p.read_bytes()).hexdigest()
        return out

    def backups(self):
        b = self.state / "backups"
        return sorted(p for p in b.rglob("*") if p.is_file() or p.is_symlink()) if b.exists() else []

    def done(self):
        shutil.rmtree(self.root)


if not shutil.which("herdr"):
    sys.exit("install-probe: needs herdr on PATH (https://herdr.dev); it never talks to a server")

print("a fresh home")
h = Home()
r = h.run("install", "--check")
check("--check plans and writes nothing", r.returncode == 0 and h.snapshot() == {} and "create" in r.stdout,
      r.stdout + r.stderr)
r = h.run("install")
check("install succeeds with nothing to ask", r.returncode == 0, r.stdout + r.stderr)
check("a starter config.toml", h.cfg.read_text().startswith("# Agent Office config"))
check("the generated herdr config", h.gen.read_text().startswith("# Generated by Agent Office"))
check("the sound next to it", (h.gen.parent / "sounds" / "silent.mp3").read_bytes()
      == (REPO / "preset/herdr/sounds/silent.mp3").read_bytes())
check("the office command, linked", os.readlink(h.link) == str(OFFICE))
check("a manifest of what it owns", '"sha256"' in (h.state / "manifest.json").read_text())
check("never ~/.config/herdr", not (h.home / ".config" / "herdr").exists())
before = h.snapshot()
r = h.run("install")
check("a second run changes nothing", r.returncode == 0 and "Nothing to change" in r.stdout
      and h.snapshot() == before, r.stdout + r.stderr)
r = h.run("help", cmd=h.link)
check("the linked command runs", r.returncode == 0 and "office install" in r.stdout, r.stderr)

print("your config drives herdr's")
h.cfg.write_text('schema = 1\n[herdr.ui]\nagent_panel_sort = "priority"\n[meter]\ninterval_seconds = 60\n')
r = h.run("install")
gen = h.gen.read_text()
check("an owned file is updated without asking", r.returncode == 0 and "update" in r.stdout, r.stdout + r.stderr)
check("[herdr] passes through", 'agent_panel_sort = "priority"' in gen)
check("the rest of the preset stays", 'prefix = "ctrl+space"' in gen and "done_path" in gen)
check("no backup of our own output", h.backups() == [])
check("your config was left as you wrote it", "priority" in h.cfg.read_text() and "Agent Office config" not in h.cfg.read_text())
r = h.run("config", "check")
check("config check: ok", r.returncode == 0 and "config: ok" in r.stdout, r.stdout + r.stderr)
r = h.run("config", "show")
check("config show has defaults and yours", "interval_seconds = 60" in r.stdout and 'session = "office"' in r.stdout
      and 'agent_panel_sort = "priority"' in r.stdout, r.stdout + r.stderr)

print("a bad config changes nothing")
before = h.snapshot()
for text, says in [
    ('schema = 1\n[firstmate]\nhom = "~/x"\n', "unknown key firstmate.hom"),
    ('schema = 1\n[meter]\nenabled = "yes"\n', "meter.enabled must be true or false"),
    ('schema = 1\n[meter]\nwarn_tokens = 900000\n', "warn_tokens must be below"),
    ('schema = 1\nextra = 1\n', "unknown key extra"),
    ('[office]\nsession = "x"\n', "schema is missing"),
    ('schema = 1\n[office]\nsession = "a b"\n', "office.session must be"),
    ('schema = 1\n[firstmate]\ncode = "relative/path"\n', "absolute path"),
    ('schema = 1\n[firstmate\n', "not valid TOML"),
]:
    h.cfg.write_text(text)
    r = h.run("install", "--yes")
    check(f"refused: {says}", r.returncode == 1 and says in r.stderr, r.stdout + r.stderr)
h.cfg.write_text('schema = 1\n[herdr.ui]\nbogus_key = 1\n')
r = h.run("install", "--yes")
check("herdr itself refuses an unknown [herdr] key", r.returncode == 1 and "ui.bogus_key" in r.stderr,
      r.stdout + r.stderr)
r = h.run("config", "check")
check("config check says so too", r.returncode == 1 and "ui.bogus_key" in r.stderr, r.stdout + r.stderr)
h.cfg.write_text('schema = 1\n')
after = {k: v for k, v in h.snapshot().items() if k != str(h.cfg)}
check("no file changed by a refused run", after == {k: v for k, v in before.items() if k != str(h.cfg)})

print("config values are data")
mark = h.root / "pwned"
h.cfg.write_text(f'schema = 1\n[firstmate]\ncode = "~/$(touch {mark})"\nhome = "/x/`touch {mark}`"\n')
r = h.run("install")
r2 = h.run("config", "show")
check("nothing in a value was run", r.returncode == 0 and not mark.exists(), r.stdout + r.stderr)
check("and it reads back literally", f"$(touch {mark})" in r2.stdout, r2.stdout)
h.cfg.write_text('schema = 1\n')
h.run("install")

print("a hand-edited or foreign file is asked about and backed up")
h.gen.write_text(h.gen.read_text() + "# my edit\n")
r = h.run("install")
check("without a terminal or --yes it refuses", r.returncode == 1 and "not confirmed" in r.stderr
      and "# my edit" in h.gen.read_text(), r.stdout + r.stderr)
check("and shows the diff", "-# my edit" in r.stdout, r.stdout)
r = h.run("install", "--yes")
check("--yes replaces it", r.returncode == 0 and "# my edit" not in h.gen.read_text(), r.stdout + r.stderr)
check("after a backup", any("# my edit" in p.read_text() for p in h.backups() if p.name == "config.toml"))
h.link.unlink()
h.link.write_text("#!/bin/sh\necho mine\n")
r = h.run("install", "--yes")
check("a foreign ~/.local/bin/office is backed up, then linked",
      r.returncode == 0 and os.readlink(h.link) == str(OFFICE)
      and any(p.name == "office" and "mine" in p.read_text() for p in h.backups()), r.stdout + r.stderr)
n = len(h.backups())
for _ in range(2):  # usually within one second, so both land in one backup folder
    h.gen.write_text(h.gen.read_text() + "# again\n")
    h.run("install", "--yes")
check("two backups of one file keep both", len(h.backups()) == n + 2, str(h.backups()))
h.cfg.unlink()
os.symlink(h.root / "gone.toml", h.cfg)
r = h.run("install", "--yes")
check("a config that is a broken link is an error, not replaced",
      r.returncode == 1 and "cannot read" in r.stderr and h.cfg.is_symlink(), r.stdout + r.stderr)
h.done()

print("moving from the tmux office (0.x)")
h = Home()
old = "/somewhere/else/agent-office"
zshrc = h.home / ".zshrc"
zshrc.write_text(f"export EDITOR=vi\n\n# office — one command for a multi-agent tmux cockpit\nsource {old}/office.zsh\n"
                 '\n# office — and everything else you install for yourself\nexport PATH="$HOME/.local/bin:$PATH"\n')
os.chmod(zshrc, 0o600)
tmux = h.home / ".tmux.conf"
tmux_text = f"set -g mouse on\n\n# office — bindings and pane borders (colours stay yours)\nsource-file {old}/office.tmux.conf\n"
tmux.write_text(tmux_text)
h.link.parent.mkdir(parents=True)
os.symlink(f"{old}/bin/office-tmux", h.link)
herdr_cfg = h.home / ".config" / "herdr" / "config.toml"
herdr_cfg.parent.mkdir(parents=True)
herdr_cfg.write_text('[ui]\nagent_panel_sort = "priority"\n')
r = h.run("install", "--check")
check("the plan names the old line and the old link", r.returncode == 0 and f"source {old}/office.zsh" in r.stdout
      and f"{old}/bin/office-tmux" in r.stdout, r.stdout + r.stderr)
r = h.run("install", "--yes")
check("install succeeds", r.returncode == 0, r.stdout + r.stderr)
check(".zshrc keeps everything else", zshrc.read_text() == 'export EDITOR=vi\n\n# office — and everything else you '
      'install for yourself\nexport PATH="$HOME/.local/bin:$PATH"\n', repr(zshrc.read_text()))
check(".zshrc keeps its mode", (zshrc.stat().st_mode & 0o777) == 0o600)
# every verb 1.0 has not built yet still runs the tmux office, which needs these
check(".tmux.conf is untouched", tmux.read_text() == tmux_text, repr(tmux.read_text()))
check("the old command link now points here", os.readlink(h.link) == str(OFFICE))
names = {p.name: p for p in h.backups()}
check("both backed up as they were", ".zshrc" in names and "office.zsh" in names[".zshrc"].read_text()
      and "office" in names and os.readlink(names["office"]) == f"{old}/bin/office-tmux", str(names))
check("~/.config/herdr untouched", herdr_cfg.read_text() == '[ui]\nagent_panel_sort = "priority"\n')
before = h.snapshot()
r = h.run("install")
check("a second run changes nothing", r.returncode == 0 and h.snapshot() == before, r.stdout + r.stderr)
h.done()

print("a startup file that is a link is never written through")
h = Home()
dot = h.root / "dotfiles"
dot.mkdir()
(dot / "zshrc").write_text(f"alias ll='ls -l'\nsource /old/agent-office/office.zsh\n")
os.symlink(dot / "zshrc", h.home / ".zshrc")
r = h.run("install", "--yes")
check("install succeeds", r.returncode == 0, r.stdout + r.stderr)
check("the link and its target are untouched", (h.home / ".zshrc").is_symlink()
      and "office.zsh" in (dot / "zshrc").read_text())
check("you are told the exact line", "manual" in r.stdout and "line 2: source /old/agent-office/office.zsh" in r.stdout,
      r.stdout)
h.done()

print("the tmux office (0.x) still answers its own verbs")
h = Home()
r = h.run("--version")
check("office --version", r.returncode == 0 and r.stdout.startswith("office "), r.stdout + r.stderr)
r = h.run("keys")
check("office keys prints the key sheet", r.returncode == 0
      and r.stdout == (REPO / "preset" / "keys.txt").read_text(), r.stdout + r.stderr)
r = h.run("install", "--theme")
check("--theme points to bin/install-tmux", r.returncode == 2 and "bin/install-tmux" in r.stderr, r.stderr)
if shutil.which("zsh"):
    r = subprocess.run([str(REPO / "bin" / "office-tmux"), "help"], capture_output=True, text=True,
                       env=dict(os.environ, HOME=str(h.home)), stdin=subprocess.DEVNULL)
    check("bin/office-tmux help is the tmux office", r.returncode == 0 and "office on" in r.stdout, r.stderr)
h.done()

# --- office doctor ---------------------------------------------------------------------------
# Fake programs on a PATH of their own, each where its owner would put it: a doctor run must never
# depend on, or reach, what this machine has installed. Only git is real.


def program(h, path, version, extra=""):
    """A fake program at path under the throwaway home, linked from its PATH folder like an install."""
    real = h.home / path
    real.parent.mkdir(parents=True, exist_ok=True)
    real.write_text(f'#!/bin/sh\n{extra}\n[ "$1" = --version ] && {{ echo "{version}"; exit 0; }}\nexit 1\n')
    real.chmod(0o755)
    link = h.home / "fakebin" / real.name.split(".")[0]
    link.parent.mkdir(exist_ok=True)
    if link != real:
        os.symlink(real, link)


def office_kit(h, integration="claude: current (v10) (/x)\ncodex: not installed (/y)"):
    program(h, "brew/Cellar/herdr/0.9.1/bin/herdr", "herdr 0.9.1",
            f'[ "$1 $2" = "integration status" ] && {{ printf "{integration}\\n"; exit 0; }}')
    program(h, "fakebin/treehouse", "v3.1.0")
    program(h, "brew/Cellar/jq/1.8.2/bin/jq", "jq-1.8.2")
    program(h, "nm/bin/no-mistakes", "no-mistakes version v1.84.0 (4822244) 2026-09-26T08:31:07Z")
    for tool in ("gh-axi", "chrome-devtools-axi", "lavish-axi", "quota-axi", "tasks-axi", "gnhf"):
        program(h, f"node/lib/node_modules/{tool}/dist/bin/{tool}.js", "0.1.35")
    program(h, "claude/versions/claude.2.1", "2.1.287 (Claude Code)")
    program(h, "brew/Caskroom/codex/0.159.2/bin/codex", "codex-cli 0.159.2")
    os.symlink(shutil.which("git"), h.home / "fakebin" / "git")
    fm = h.home / "firstmate"
    fm.mkdir()
    git = ["git", "-C", str(fm), "-c", "user.name=probe", "-c", "user.email=probe@example.invalid"]
    subprocess.run([*git, "init", "-q"], check=True)
    subprocess.run([*git, "commit", "-q", "--allow-empty", "-m", "probe"], check=True)
    subprocess.run([*git, "remote", "add", "origin", "https://github.com/kunchenguid/firstmate.git"], check=True)
    return subprocess.run([*git, "rev-parse", "HEAD"], capture_output=True, text=True).stdout.strip()


print("office doctor: a healthy office")
h = Home()
rev = office_kit(h)
manifest = h.root / "components.toml"
manifest.write_text((REPO / "config" / "components.toml").read_text()
                    .replace('tested = []                   # none yet: needs a herdr + Firstmate + treehouse lab run\n\n'
                             '[[component]]\nname = "jq"', 'tested = ["3.1.0"]\n\n[[component]]\nname = "jq"')
                    .replace("[firstmate]\ntested = []", f'[firstmate]\ntested = ["{rev}"]'))
sys.path.insert(0, str(REPO / "lib"))
from agent_office import doctor  # noqa: E402
out, err = io.StringIO(), io.StringIO()
code = doctor.run([], env=h.env(PATH=str(h.home / "fakebin")), out=out, err=err, manifest=manifest)
said = out.getvalue()
check("exit 0 and no problems", code == 0 and said.rstrip().endswith("No problems."), said + err.getvalue())
rows = {r[1]: r[2:] for r in (re.split(r"\s{2,}", l.strip()) for l in said.splitlines()) if r[0] in ("ok", "PROBLEM")}
for name, want in (("herdr", ["0.9.1", "Homebrew (herdr)", "tested"]),
                   ("treehouse", ["3.1.0", "itself (treehouse update)", "tested"]),
                   ("jq", ["1.8.2", "Homebrew (jq)", "no version pinned"]),
                   ("gh-axi", ["0.1.35", "npm, global (gh-axi)", "no version pinned"]),
                   ("claude", ["2.1.287", "itself (claude update)", "no version pinned"]),
                   ("herdr claude integration", ["current (v10)", "herdr", "current"]),
                   ("firstmate", [rev[:12], "git, from firstmate.source", "tested"])):
    check(f"{name}: {', '.join(want)}", rows.get(name) == want, said)
h.done()

print("office doctor: unknown is not healthy")
h = Home()
office_kit(h, integration="claude: current (v10) (/x)\ncodex: outdated (v7) (/y)")
(h.home / "fakebin" / "jq").unlink()
program(h, "fakebin/jq", "jq-1.8.2")                                  # owner unknown
(h.home / "fakebin" / "gnhf").unlink()                                # missing
lavish = next((h.home / "node").rglob("lavish-axi.js"))
lavish.write_text("#!/bin/sh\nexit 1\n")                             # no version
h.cfg.parent.mkdir(parents=True)
h.cfg.write_text('schema = 1\n[firstmate]\nharness = "codex"\nsource = "https://example.invalid/fork.git"\n'
                 'home = "~/no-such-home"\n[treehouse]\nroot = "~/no-such-pool"\n')
before = h.snapshot()
r = h.run("doctor", PATH=str(h.home / "fakebin"))
check("exit 1", r.returncode == 1, r.stdout + r.stderr)
for want in ("treehouse: 3.1.0 is not a version this release is tested with (tested: none yet)",
             "jq: nothing says how ~/fakebin/jq is updated (owner unknown)",
             "gnhf: gnhf is not on PATH",
             "lavish-axi: `lavish-axi --version` gave no version",
             "herdr codex integration: outdated (v7): `herdr integration install codex` installs it",
             "firstmate: no remote of the checkout is the configured source https://example.invalid/fork.git",
             "firstmate: commit ",
             "firstmate home: no folder at ~/no-such-home (firstmate.home)",
             "treehouse root: no folder at ~/no-such-pool (treehouse.root)"):
    check(f"reports: {want}", want in r.stdout, r.stdout)
check("9 problems, no more", "9 problem(s):" in r.stdout, r.stdout)
check("your home is never printed", str(h.home) not in r.stdout + r.stderr, r.stdout)
check("it changed nothing", h.snapshot() == before)
r = h.run("doctor", "--fix")
check("an unknown option is refused", r.returncode == 2 and "unknown option --fix" in r.stderr, r.stderr)
h.done()

print("PASS" if not fails else f"FAIL: {fails}")
sys.exit(1 if fails else 0)
