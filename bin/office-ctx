#!/bin/sh
# office-ctx — how full is this desk's context window? One number for its border.
#
# The question this answers is "which of these four should I compact", and until
# now the only way to ask it was to walk into each pane and run /context. With
# three or four desks that is three or four interruptions to learn one number
# each, and the one that matters is usually the desk you are NOT looking at.
#
#     2 CLAUDE · desk-2 · port the payment tests      412k   your turn 4m
#
# Colour is the point of it, and it is the theme that supplies it: under the warn
# mark the number is furniture, over it the number is a decision. Both marks are
# yours (OFFICE_CTX_WARN / OFFICE_CTX_ALARM) because "full" depends on the window
# your plan gets, and that is not a thing this script can know.
#
# HOW A PANE FINDS ITS OWN SESSION, which is the part with no obvious answer.
# There is no environment variable to read and nothing on the screen to scrape,
# but Claude Code writes ~/.claude/sessions/<pid>.json for every session it runs,
# and that file names the session id. So: take the process GROUP of the pane (the
# agent is a child of the pane's shell, never the pane process itself, because
# office appends a line to the command), ask which member of that group has such
# a file, and read the id out of it. Exact, and no guessing from directory names —
# two desks in one checkout would be indistinguishable that way.
#
# The transcript is then ~/.claude/projects/<slug>/<id>.jsonl, where the slug is
# the LAUNCH directory with / and . beaten into -. It is the launch directory and
# not the pane's current one: a session that cd'd somewhere else still writes to
# the folder it started in, so deriving the slug from #{pane_current_path} finds
# nothing. The id is also globbed for as a fallback, because the slug rule is
# Claude Code's and could change under us; the id is in the filename either way.
#
# The number itself is what the model was last handed: input + cache-creation +
# cache-read on the most recent usage record. That is the definition /context
# uses, and cache-read is nearly all of it, which is why leaving it out (the
# obvious reading of "input_tokens") reports a few hundred tokens for a session
# holding two hundred thousand.
#
# TWO READOUTS, ONE FILE, AND THEY ARE NOT THE SAME QUESTION.
#
#   the NUMBER is Claude Code only, because it means reading a usage record and
#   every CLI writes a different one. A guessed number on a border is worse than
#   no number, so a desk office cannot read simply has none.
#
#   @office_wrote is every CLI that has a transcript at all, because it is only
#   the file's mtime — the second the agent's last line, or your last prompt,
#   hit the disk. Nothing has to be parsed to know that. office-attn reads it for
#   the "your turn" clock, which is really the CACHE clock: an hour with nothing
#   written and the provider has dropped whatever it was holding, so the next
#   thing you say is charged as a brand new conversation.
#
# So the shape is a table of readers, `tx_<cli>`, each answering one question:
# which file is THIS pane writing to? The first that answers wins, and adding a
# CLI is one function. @office_tx_cmd is the same question asked of a command of
# your own, for the twenty CLIs that are not in here — it is handed the pane id
# and prints a path, and it is tried FIRST so it can override anything below.
# A reader prints a path or nothing; there is no second field and no state.
#
# EVERY READER PROVES THE CLI IS RUNNING IN THIS PANE, and it is not optional.
# The rule was learned the hard way: a reader that matched on a directory alone
# attached a Claude desk to a rollout the ChatGPT app had written in that
# directory four hours earlier. The border then said "your turn 4h18m" at a desk
# that was working, and lost its context number, because the file it was reading
# had nothing to do with it. A directory is not an identity. The pane's process
# group is, and asking for it is one `ps`.
#
# ponytail: NO CACHE. There was one, keyed on the pane, and it is what turned
# that wrong answer into a permanent one — nothing about a pane changes when the
# session inside it does, so the wrong file stayed cached all day. Resolving
# costs 25ms (measured, `ps -ax -o pid=,pgid=` five times in 126ms), which is
# what this script did every tick for months before the cache existed. A readout
# that is right is worth 25ms; one that cannot recover from being wrong is not
# worth anything.
id=${1:?usage: office-ctx <pane-id>}

IFS='|' read -r pid warn alarm swarn salarm had cwd hook <<EOF
$(tmux display -p -t "$id" '#{pane_pid}|#{@office_ctx_warn}|#{@office_ctx_alarm}|#{@office_ctx_style_warn}|#{@office_ctx_style_alarm}|#{@office_wrote}|#{pane_current_path}|#{@office_tx_cmd}' 2>/dev/null)
EOF
[ -n "$pid" ] || exit 0
[ -n "$warn" ]  || warn=400000
[ -n "$alarm" ] || alarm=600000

# An agent that ENDED leaves the pane as a shell (office.zsh appends that line to
# every desk command), and the pane keeps its CLAUDE kind — so this script keeps
# being called and finds nothing. Whatever is left in @office_wrote is then a
# dead session's clock, and office-attn would go on counting the hours since it
# as though the desk were merely quiet. Drop it on every way out that found no
# transcript, and only when there IS one to drop, so the usual case costs no fork.
forget() { [ -n "$had" ] && tmux set -up -t "$id" @office_wrote 2>/dev/null; exit 0; }

# --- which file is this pane writing to? --------------------------------------
# WHO IS ACTUALLY IN THIS PANE. One `ps`, read once, and every reader below
# answers against it rather than against the pane's directory. The agent is a
# CHILD of the pane's shell, never the pane process itself, because office
# appends a line to the command -- so it is the process GROUP that has to be
# asked, not the pane pid.
#
# `pid comm` per line, the pane's group only. An empty answer means the pane is
# running nothing but its shell, and then no reader may claim it.
# The command is taken as the REST of the line and then cut back to its
# basename, never as $3: macOS prints the whole path where Linux prints the name,
# and a path with a space in it would otherwise split into two fields and lose
# the name entirely.
group=$(ps -ax -o pid=,pgid=,comm= 2>/dev/null | awk -v want="$pid" '
  { pg[$1] = $2
    c = $0; sub(/^[[:space:]]*[0-9]+[[:space:]]+[0-9]+[[:space:]]+/, "", c)
    sub(/.*\//, "", c); cm[$1] = c }
  END { g = pg[want]; if (g == "") exit
        for (p in pg) if (pg[p] == g) print p, cm[p] }')

# CLAUDE CODE. There is no environment variable to read and nothing on the screen
# to scrape, but Claude Code writes ~/.claude/sessions/<pid>.json for every
# session it runs, and that file names the session id. So: take the process GROUP
# of the pane (the agent is a child of the pane's shell, never the pane process
# itself, because office appends a line to the command), ask which member of that
# group has such a file, and read the id out of it. Exact, and no guessing from
# directory names — two desks in one checkout would be indistinguishable that way.
#
# The transcript is then ~/.claude/projects/<slug>/<id>.jsonl, where the slug is
# the LAUNCH directory with / and . beaten into -. It is the launch directory and
# not the pane's current one: a session that cd'd somewhere else still writes to
# the folder it started in. The id is also globbed for as a fallback, because the
# slug rule is Claude Code's and could change under us; the id is in the filename
# either way.
#
# Splitting the JSON on quotes rather than matching a pattern per key:
# `"sessionId":"VALUE"` splits so that the key and the value are two fields apart,
# which needs no regex and cannot be fooled by the order of the keys.
tx_claude() {
  [ -d "$HOME/.claude/sessions" ] || return 0
  IFS='|' read -r apid sid scwd <<EOF
$(printf '%s\n' "$group" | awk -v home="$HOME" '
  {
    f = home "/.claude/sessions/" $1 ".json"
    all = ""; while ((getline l < f) > 0) all = all l
    close(f)
    if (all == "") next
    n = split(all, q, "\"")
    sid = ""; cwd = ""
    for (i = 1; i < n - 1; i++) {
      if (q[i] == "sessionId" && sid == "") sid = q[i + 2]
      if (q[i] == "cwd"       && cwd == "") cwd = q[i + 2]
    }
    if (sid == "") next
    print $1 "|" sid "|" cwd
    exit
  }')
EOF
  [ -n "$sid" ] || return 0
  f="$HOME/.claude/projects/$(printf '%s' "$scwd" | tr '/.' '--')/$sid.jsonl"
  [ -r "$f" ] && { printf '%s' "$f"; return 0; }
  for f in "$HOME"/.claude/projects/*/"$sid.jsonl"; do
    [ -r "$f" ] && { printf '%s' "$f"; return 0; }
  done
}

# CODEX writes ~/.codex/sessions/<Y>/<M>/<D>/rollout-<when>-<uuid>.jsonl and keys
# nothing by pid, so the trick above has nothing to grab. What it DOES record is
# the directory it started in, on its first line, as session_meta.cwd.
#
# THE DIRECTORY IS THE SECOND QUESTION, NEVER THE FIRST. Asked on its own it
# attached a CLAUDE desk to a rollout the ChatGPT app had written in that same
# directory four hours before -- a real border, reading "your turn 4h18m" at a
# desk that was working, with its context number gone. So the reader only runs
# at all when a `codex` process is in THIS pane's group, and the directory then
# only picks between that pane's own sessions.
#
# Two Codex desks started by hand in one directory would still be ambiguous, and
# the newest wins; in an office they cannot be, because every agent after the
# first gets its own worktree. That is the known ceiling, and the fix would be a
# pid file only Codex can write.
#
# A rollout name begins with its own timestamp and sits under <Y>/<M>/<D>, so the
# whole path sorts chronologically and a reverse sort is newest-first. Only the
# 40 newest are opened, and `find` rather than a glob because a year of sessions
# is more arguments than a shell will pass.
tx_codex() {
  [ -d "$HOME/.codex/sessions" ] || return 0
  printf '%s\n' "$group" | grep -q ' codex$' || return 0
  for f in $(find "$HOME/.codex/sessions" -type f -name 'rollout-*.jsonl' 2>/dev/null \
             | sort -r | head -40); do
    head -n 1 "$f" 2>/dev/null | grep -q "\"cwd\":\"$cwd\"" && { printf '%s' "$f"; return 0; }
  done
}

# The readers, in order, first answer wins. @office_tx_cmd is yours and is tried
# FIRST so it can override both. There is no cache: see the head of this file for
# what one cost, and what resolving costs instead.
tx=""
[ -n "$hook" ] && tx=$($hook "$id" 2>/dev/null)
[ -n "$tx" ] || tx=$(tx_claude)
[ -n "$tx" ] || tx=$(tx_codex)
[ -r "$tx" ] || forget

# WHEN did this desk last write? The transcript's mtime: the moment the agent's
# last line, or your last prompt, hit the file. This is the half that works for
# EVERY CLI above, because it needs no format at all — office never opens the
# file to answer it. office-attn reads it as @office_wrote for the "your turn"
# clock, which is really the CACHE clock: an hour with nothing written and the
# provider has dropped whatever it was holding.
#
# Screen-watching can only say "nothing has moved since I last looked", which is
# a proxy for the question and not an answer to it: right to about a tick while a
# desk sits still, and wrong whenever the pixels move for a reason that is not a
# turn. A pane that changed shape is the common one, and office-attn skips those
# looks now. The file does not move when the screen does.
#
# BSD form then GNU, and it is the ANSWER that decides, never the exit status:
# GNU's -f means "the filesystem", takes no %m, and prints `?` while exiting 0 —
# so a plain `stat -f %m || stat -c %Y` would leave `?` on the pane, and
# office-attn would do arithmetic on it. Digits, or nothing.
wrote=$(stat -f %m "$tx" 2>/dev/null)
case $wrote in *[!0-9]*|"") wrote=$(stat -c %Y "$tx" 2>/dev/null) ;; esac
case $wrote in *[!0-9]*|"") wrote="" ;; esac
# An empty answer CLEARS it, the same as finding no transcript at all. The file
# can go between the read above and this line, and leaving the old number there
# would have office-attn counting from a moment that no longer means anything.
if [ -n "$wrote" ]; then tmux set -p -t "$id" @office_wrote "$wrote" 2>/dev/null
elif [ -n "$had" ]; then tmux set -up -t "$id" @office_wrote 2>/dev/null
fi

# ...and here the shared half ends. The NUMBER is a usage record, and that is
# Claude Code's shape: Codex writes `token_count` events with different keys
# again, and a plausible wrong number on a border is worse than an empty one. So
# anything that is not a Claude Code transcript has had its whole job done above.
# (Codex does carry its own token totals, and a reader for them is a real thing
# to add — measured against a live Codex desk, not guessed at from a file.)
case $tx in
  *"/.claude/projects/"*) ;;
  *) exit 0 ;;
esac

# The last usage record. `tail -c` bounds the read to the end of what can be a
# very large file, and the `^{` test throws away the partial line that bound
# leaves behind. Only the first hit for each key on a line is taken: the
# top-level usage comes before the per-iteration copies of the same keys.
#
# `seen[k]`, and not `if (value == 0)`, to mean "already had this key". A real
# record often carries input_tokens 0 or cache_creation 0, and treating zero as
# "not filled in yet" let the iterations copy overwrite it — every number came
# out about 20k high, which is exactly plausible enough to be believed.
ctx=$(tail -c 400000 "$tx" 2>/dev/null | awk '
  /^\{/ && /"usage"/ {
    n = split($0, q, "\"")
    total = 0; delete seen
    for (i = 1; i < n; i++) {
      k = q[i]
      if (k != "input_tokens" && k != "cache_creation_input_tokens" \
          && k != "cache_read_input_tokens") continue
      if (k in seen) continue
      if (!match(q[i + 1], /^:[ ]*[0-9]+/)) continue
      seen[k] = 1
      total += substr(q[i + 1], RSTART + 1, RLENGTH - 1) + 0
    }
  }
  END { print total + 0 }')
[ -n "$ctx" ] && [ "$ctx" -gt 0 ] || exit 0

if [ "$ctx" -ge 1000000 ]; then
  num="$((ctx / 1000000)).$((ctx % 1000000 / 100000))M"
else
  num="$((ctx / 1000))k"
fi

if   [ "$ctx" -ge "$alarm" ]; then style=$salarm
elif [ "$ctx" -ge "$warn" ];  then style=$swarn
else                               style=""
fi

printf '  %s%s#[default]' "$style" "$num"
