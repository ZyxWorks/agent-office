#!/usr/bin/env python3
"""Press a key at a real tmux client. Where did it end up?

Run it after ANY change to key handling. It builds a throwaway office on its own
socket, attaches a client on a pty it can write raw bytes into, and checks both
halves of the contract at once:

  - a key the office BINDS moves you, and never reaches the pane
  - every other key reaches the pane byte for byte, including the modified ones
    ASCII has no encoding for

The keys to watch are not the one you meant to change. They are the twenty you
did not. Exits non-zero if any of them moved.

    bin/key-probe

`tmux send-keys` cannot do this job: it writes to the pane's tty directly, so it
never consults a key table. Shift-Left looks "broken" under send-keys and works
perfectly for a human. Only a real client tests what a human presses.
"""
import os, pathlib, pty, select, subprocess, sys, tempfile, termios, time, tty

SOCK = "office-key-probe"
CONF = pathlib.Path(__file__).resolve().parent.parent / "office.tmux.conf"
WINDOW = 12  # seconds the recorder pane listens for

# The config is loaded when the SERVER STARTS, with -f, and not with a
# `source-file` afterwards. Measured, because the difference is invisible in the
# options: after a late source-file `show -s extended-keys` says `always` and
# `terminal-features` carries `xterm*:extkeys`, exactly as it should, and
# Shift-Enter still arrives at the pane as a bare \r. Loaded at start it works.
#
# What that cost before it was found: this probe silently borrowed the AUTHOR's
# ~/.tmux.conf, which sources office.tmux.conf and therefore armed the server for
# it. Anyone who cloned the repo and ran the probe before installing office got
# "KEY HANDLING CHANGED" against untouched code, and so did CI.


MOVES = "moves the pane"

# raw bytes in at the client -> what the pane must receive, or MOVES.
#
# Shift-Enter appears twice on purpose: a terminal may announce it in either
# dialect, and tmux normalises both to the one form. That is what lets an app
# tell Shift-Enter from Enter, which is the whole point of the setting.
# Shift-Enter is the one key whose expected bytes are a SET rather than a value.
# tmux picks the encoding by version - 3.4 forwards CSI 13;2u, 3.5 and later
# CSI 27;2;13~, which is when extended-keys-format arrived with `xterm` as its
# default - and the office deliberately does not pin it: the option does not exist
# on 3.4, so setting it would print "invalid option" into every reload of the very
# config that is meant to make keys work. What has to hold is that the MODIFIER
# survives at all, in either dialect, because an app that negotiated extended keys
# reads both. Asserting one dialect made this probe fail on Ubuntu against code
# that was fine.
EITHER_SHIFT_ENTER = (rb"\x1b[27;2;13~", rb"\x1b[13;2u")

CASES = [
    (rb"\x1b[1;2D", "Shift-Left",              MOVES),
    (rb"\x1b[1;2C", "Shift-Right",             MOVES),
    (rb"\x1b[27;2;13~", "Shift-Enter (xterm)", EITHER_SHIFT_ENTER),
    (rb"\x1b[13;2u", "Shift-Enter (csi-u)",    EITHER_SHIFT_ENTER),
    (rb"\r", "Enter",         rb"\r"),
    (rb"\t", "Tab",           rb"\t"),
    (rb"\x7f", "Backspace",   rb"\x7f"),
    (rb"\x1b", "Escape",      rb"\x1b"),
    (b"a", "a",               b"a"),
    (b"A", "A",               b"A"),
    (b" ", "Space",           b" "),
    (rb"\x03", "Ctrl-C",      rb"\x03"),
    (rb"\x01", "Ctrl-A",      rb"\x01"),
    (rb"\x04", "Ctrl-D",      rb"\x04"),
]


def raw(b):
    return b.decode("unicode_escape").encode("latin1")


def record(out):
    """Inside the pane: write down every byte that lands here."""
    fd, old = sys.stdin.fileno(), termios.tcgetattr(sys.stdin.fileno())
    tty.setraw(fd)
    buf, t = b"", time.time()
    while time.time() - t < WINDOW:
        if select.select([fd], [], [], 0.2)[0]:
            buf += os.read(fd, 256)
    termios.tcsetattr(fd, termios.TCSADRAIN, old)
    pathlib.Path(out).write_bytes(buf)


def tmux(*a):
    return subprocess.run(["tmux", "-L", SOCK, *a], capture_output=True, text=True)


def main():
    out = pathlib.Path(tempfile.mkdtemp()) / "got"
    tmux("kill-server")
    tmux("-f", str(CONF), "new-session", "-d", "-x", "120", "-y", "24",
         f"{sys.executable} {__file__} --record {out}")
    tmux("split-window", "-h", "cat")   # somewhere for a movement key to go
    tmux("select-pane", "-t", "1")

    pid, fd = pty.fork()
    if pid == 0:                         # a real client, on a pty we can type at
        os.environ["TERM"] = "xterm-256color"
        os.execvp("tmux", ["tmux", "-L", SOCK, "attach-session"])
    time.sleep(1.5)

    moves, bad = [], 0
    for sent, label, want in CASES:
        before = tmux("display", "-p", "#{pane_index}").stdout.strip()
        os.write(fd, raw(sent))
        time.sleep(0.35)
        after = tmux("display", "-p", "#{pane_index}").stdout.strip()
        if want is MOVES:
            ok = before != after
            moves.append((label, before, after, ok))
            bad += not ok
        tmux("select-pane", "-t", "1")

    # --- the prefix takes the PANE with you -----------------------------------
    # Shift-arrow moves YOU between panes. Press the prefix first and the desk
    # comes along. Checked on the pane IDS and not on which one is selected,
    # because those are two different claims and both have to hold: the panes
    # trade places, AND the cursor stays on the one that moved, which is what
    # lets a second press move it on again.
    tmux("select-pane", "-t", "1")
    before = tmux("list-panes", "-F", "#{pane_id}").stdout.split()
    mine = tmux("display", "-p", "#{pane_id}").stdout.strip()
    os.write(fd, b"\x00")
    time.sleep(0.25)
    os.write(fd, raw(rb"\x1b[1;2C"))
    time.sleep(0.6)
    after = tmux("list-panes", "-F", "#{pane_id}").stdout.split()
    active = tmux("display", "-p", "#{pane_id}").stdout.strip()
    if after == before[::-1]:
        print(f"  ok   {'prefix Shift-Right':22} pane moved {before} -> {after}")
    else:
        print(f"  FAIL {'prefix Shift-Right':22} {before} -> {after}   (did not move)")
        bad += 1
    if active == mine:
        print(f"  ok   {'...cursor follows it':22} still on {active}")
    else:
        print(f"  FAIL {'...cursor follows it':22} on {active}, wanted {mine}")
        bad += 1

    # With nothing in that direction the key has to do nothing AND say nothing.
    # These two panes are side by side, so there is no row to move into: tmux's
    # own answer is "can't find pane: {up-of}" written across the status bar,
    # which reads as a key that is broken. The guard is what stops it.
    tmux("clear-history")               # not the message log; just tidy
    os.write(fd, b"\x00")
    time.sleep(0.25)
    os.write(fd, raw(rb"\x1b[1;2A"))
    time.sleep(0.6)
    if tmux("list-panes", "-F", "#{pane_id}").stdout.split() == after:
        print(f"  ok   {'prefix Shift-Up':22} no row above: nothing moved")
    else:
        print(f"  FAIL {'prefix Shift-Up':22} no row above, but a pane moved")
        bad += 1
    msgs = tmux("show-messages").stdout
    if "can't find pane" not in msgs:
        print(f"  ok   {'...and says nothing':22} no error on the status bar")
    else:
        print(f"  FAIL {'...and says nothing':22} tmux complained: {msgs.strip()!r}")
        bad += 1
    tmux("swap-pane", "-d", "-s", after[0], "-t", after[1])   # recorder back to pane 1
    tmux("select-pane", "-t", "1")

    # ...and at an edge WITH another row, it wraps, exactly as moving between
    # panes does. Pinned here because tmux is what decides it: this ships against
    # 3.4 as well as 3.7b, the README states the wrap, and if a tmux ever stopped
    # wrapping the key would answer "can't find pane" across the status bar --
    # the one failure the guard above exists to prevent. Its own window, so the
    # two panes the byte checks need are left exactly as they were.
    tmux("new-window", "-d", "-n", "wrap", "cat")
    tmux("split-window", "-v", "-t", "wrap", "cat")
    tmux("select-window", "-t", "wrap")
    tmux("select-pane", "-t", "wrap.1")            # the TOP pane: nothing above it
    top = tmux("display", "-p", "#{pane_id}").stdout.strip()
    stacked = tmux("list-panes", "-t", "wrap", "-F", "#{pane_id}").stdout.split()
    os.write(fd, b"\x00")
    time.sleep(0.25)
    os.write(fd, raw(rb"\x1b[1;2A"))
    time.sleep(0.6)
    wrapped = tmux("list-panes", "-t", "wrap", "-F", "#{pane_id}").stdout.split()
    msgs = tmux("show-messages").stdout
    if wrapped == stacked[::-1] and "can't find pane" not in msgs:
        print(f"  ok   {'...and wraps':22} top pane sent up is the bottom one now")
    else:
        print(f"  FAIL {'...and wraps':22} {stacked} -> {wrapped}, top was {top}")
        bad += 1
    tmux("kill-window", "-t", "wrap")
    tmux("select-pane", "-t", "1")

    time.sleep(WINDOW)
    got = out.read_bytes() if out.exists() else b""
    tmux("kill-server")

    for label, before, after, ok in moves:
        print(f"  {'ok  ' if ok else 'FAIL'} {label:22} pane {before} -> {after}"
              f"{'' if ok else '   (did not move)'}")
    for sent, label, want in CASES:
        if want is MOVES:
            continue
        options = [raw(w) for w in (want if isinstance(want, tuple) else (want,))]
        hit = next((w for w in options if got.startswith(w)), None)
        if hit is not None:
            print(f"  ok   {label:22} pane got {hit!r}")
            got = got[len(hit):]
        else:
            print(f"  FAIL {label:22} expected one of "
                  f"{[o for o in options]!r}, pane got {got!r}")
            bad += 1
            break
    if got:
        print(f"  FAIL a bound key leaked into the pane: {got!r}")
        bad += 1
    print("every key landed where it should" if not bad else "KEY HANDLING CHANGED")
    return bad


if __name__ == "__main__":
    if sys.argv[1:2] == ["--record"]:
        record(sys.argv[2])
    else:
        sys.exit(min(main(), 1))
