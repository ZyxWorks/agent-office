#!/bin/sh
# meter-probe — every case meter has to get right, against a fake herdr and fake
# transcripts. No herdr server, no Claude, no network. Exit 0 = all pass.
set -u
here=$(cd "$(dirname "$0")" && pwd)
T=$(mktemp -d) && trap 'rm -rf "$T"' EXIT
mkdir -p "$T/cfg/projects/-proj-a" "$T/cfg/projects/-proj-b"
mkdir -p "$T/codex/sessions/2026/09/28"
A=$T/cfg/projects/-proj-a B=$T/cfg/projects/-proj-b
C=$T/codex/sessions/2026/09/28
fail=0
# never this machine's meter settings, plugin state or herdr server
export XDG_STATE_HOME="$T/xs" HERDR_PLUGIN_STATE_DIR="$T/state"
unset HERDR_SOCKET_PATH HERDR_CONFIG_PATH METER_EVERY METER_WARN METER_ALARM
mkdir -p "$T/state"

# fake herdr: `pane list` prints $T/panes.json (or fails when it is missing),
# `pane report-metadata` appends its argv to $T/reports.
cat >"$T/herdr" <<EOF
#!/bin/sh
case "\$1 \$2" in
  "pane list") cat "$T/panes.json" 2>/dev/null || { echo miss >>"$T/misses"; echo '{"error":{"code":"server_not_running"}}'; exit 1; } ;;
  "status server") if [ -f "$T/up" ]; then echo "status: running"; else echo "status: not running"; fi ;;
  "pane report-metadata") shift 2
    cat >/dev/null # a CLI that reads stdin must not eat the pane list
    [ "\$1" = w:gone ] && exit 1 # closed between list and report
    echo "\$*" >>"$T/reports" ;;
esac
EOF
chmod +x "$T/herdr"

# fake quota-axi and gh, first on PATH so no pass ever asks a real server. quota-axi prints
# $T/quota.src; gh applies its --jq to .fakepr in the checkout it runs in. Both log each call,
# and answer only once $T/hold is gone: a server that is slow to answer.
mkdir -p "$T/bin"
cat >"$T/bin/quota-axi" <<EOF
#!/bin/sh
echo "\$*" >>"$T/quota.calls"
while [ -f "$T/hold" ]; do sleep 0.1; done
cat "$T/quota.src" 2>/dev/null
EOF
cat >"$T/bin/gh" <<EOF
#!/bin/sh
echo "\$PWD" >>"$T/gh.calls"
while [ -f "$T/hold" ]; do sleep 0.1; done
[ -f .fakepr ] || exit 1
while [ \$# -gt 0 ]; do [ "\$1" = --jq ] && { jq -r "\$2" .fakepr; exit; }; shift; done
exit 1
EOF
chmod +x "$T/bin/quota-axi" "$T/bin/gh"
export PATH="$T/bin:$PATH"

u() { # usage record: total split as input/cache-read
  printf '{"type":"assistant","message":{"model":"%s","usage":{"input_tokens":%s,"cache_creation_input_tokens":0,"cache_read_input_tokens":%s}}}\n' "${2:-m}" 1 "$(( $1 - 1 ))"
}
pane() { printf '{"pane_id":"%s","agent_status":"%s","agent_session":{"agent":"%s","kind":"id","value":"%s"}}' "$@"; }
codexpane() { printf '{"pane_id":"%s","agent_status":"%s","agent":"codex","cwd":"%s","foreground_cwd":"%s"}' "$1" "$2" "$3" "$3"; }
codexid() { # pane status cwd session-id: herdr's Codex integration reported the session
  printf '{"pane_id":"%s","agent_status":"%s","agent":"codex","cwd":"%s","foreground_cwd":"%s","agent_session":{"agent":"codex","kind":"id","value":"%s"}}' "$1" "$2" "$3" "$3" "$4"; }
rollout() { # file cwd input-tokens [id]
  { printf '{"type":"session_meta","payload":{"cwd":"%s","id":"%s"}}\n' "$2" "${4:-}"
    printf '{"type":"token_usage_record","payload":{"usage":{"input_tokens":%s}}}\n' "$3"; } >"$C/$1"; }
run() { # panes... ; runs one pass
  printf '{"result":{"panes":[%s]}}' "$(IFS=,; echo "$*")" >"$T/panes.json"
  : >"$T/reports"
  HERDR_BIN_PATH=$T/herdr CLAUDE_CONFIG_DIR=$T/cfg CODEX_HOME=$T/codex sh "$here/meter" once
}
expect() { # pane want-substring
  got=$(grep "^$1 " "$T/reports" || echo "(no report)")
  case $got in *"$2"*) ;; *) echo "FAIL [$3] $1: want '$2' in: $got"; fail=1 ;; esac
}
never() { # pane
  grep -q "^$1 " "$T/reports" && { echo "FAIL [$2] $1 was reported: $(grep "^$1 " "$T/reports")"; fail=1; }
}
ago() { touch -t "$(date -r $(( $(date +%s) - $1 )) +%Y%m%d%H%M.%S 2>/dev/null || date -d "@$(( $(date +%s) - $1 ))" +%Y%m%d%H%M.%S)" "$2"; }

# 1 idle: number and clock
u 58084 >"$A/s1.jsonl"; ago 300 "$A/s1.jsonl"
# 2 working: number, no clock
u 120000 >"$A/s2.jsonl"
# 3 blocked on a prompt counts as your turn; over an hour shows whole hours only
u 90000 >"$B/s3.jsonl"; ago 4500 "$B/s3.jsonl"
# 4 done counts too
u 1000 >"$A/s4.jsonl"
# 5 no transcript yet (fresh /clear): both cleared
# 6 a <synthetic> zero record after an interrupt does not wipe the number
{ u 200000; echo '{"type":"assistant","message":{"model":"<synthetic>","usage":{"input_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":0}}}'; } >"$A/s6.jsonl"
# 7 compacted since the last reply: no number until the next one
{ u 500000; echo '{"type":"system","subtype":"compact_boundary"}'; } >"$A/s7.jsonl"
# 8 a reply after the compact brings the number back
{ u 500000; echo '{"type":"system","subtype":"compact_boundary"}'; u 30000; } >"$A/s8.jsonl"
# 9 sidechain records never count
{ u 70000; printf '{"isSidechain":true,"type":"assistant","message":{"usage":{"input_tokens":1,"cache_read_input_tokens":999999}}}\n'; } >"$A/s9.jsonl"
# 10 warn and alarm marks
u 250000 >"$A/s10.jsonl"; u 700000 >"$A/s11.jsonl"
# 12 a broken line and missing fields do not break the pass
{ u 40000; echo 'not json {'; echo '{"message":{"usage":{"input_tokens":5000}}}'; } >"$A/s12.jsonl"
# 13 clock in the future (a touched file, a clock jump) reads 0m, never negative
u 1000 >"$A/s13.jsonl"; touch -t 209901010000 "$A/s13.jsonl"
# 14 a subagent transcript with the same name under <id>/subagents is not the session
mkdir -p "$A/s14/subagents"; u 999000 >"$A/s14/subagents/s14.jsonl"
# 15 Codex's newest context is input_tokens; cached_input_tokens is already included.
CODEX_WT=$T/codex-worktree
{ printf '%s\n' '{"type":"session_meta","payload":{"cwd":"'"$CODEX_WT"'"}}'
  printf '%s\n' '{"type":"token_usage_record","payload":{"usage":{"input_tokens":123456,"cached_input_tokens":100000,"output_tokens":42}}}'
  printf '%s\n' '{"type":"event_msg","payload":{"type":"token_count","info":{"last_token_usage":{"input_tokens":123456},"model_context_window":258400}}}'
} >"$C/rollout-2026-09-28T00-00-00-codex.jsonl"
ago 300 "$C/rollout-2026-09-28T00-00-00-codex.jsonl"
# 15b a working Codex desk in a directory of its own: number, no clock
rollout rollout-2026-09-28T00-00-01-work.jsonl "$T/codex-work" 64000
# 18 two Codex panes in one directory, no session ids: a match by directory could be either's
rollout rollout-2026-09-28T00-00-02-shared.jsonl "$T/codex-shared" 99000
# 19 with herdr's session id the rollout is exact, even in a shared directory; the newest
# rollout there (the shared one above, written later) must not win
rollout rollout-2026-09-28T00-00-00-0190aaaa-1111-7222-8333-444455556666.jsonl "$T/codex-shared" 41000 \
  0190aaaa-1111-7222-8333-444455556666
# 20 a Codex pane where Claude ran before still carries Claude's session: Codex is read, never s1
rollout rollout-2026-09-28T00-00-03-was-claude.jsonl "$T/codex-was-claude" 77000
# 16 A local model launched through Claude Code keeps the Claude transcript shape.
printf '%s\n' '{"type":"assistant","message":{"model":"gemma4:12b","usage":{"input_tokens":1,"cache_creation_input_tokens":0,"cache_read_input_tokens":29999}}}' >"$A/s17.jsonl"
# 17 A local/unsupported agent has no reader, so it must not inherit another desk's number.

run "$(pane w:p1 idle claude s1)" "$(pane w:p2 working claude s2)" "$(pane w:p3 blocked claude s3)" \
    "$(pane w:p4 "done" claude s4)" "$(pane w:p5 idle claude s5)" "$(pane w:p6 idle claude s6)" \
    "$(pane w:p7 idle claude s7)" "$(pane w:p8 idle claude s8)" "$(pane w:p9 idle claude s9)" \
    "$(pane w:p10 idle claude s10)" "$(pane w:p11 idle claude s11)" "$(pane w:p12 idle claude s12)" \
    "$(pane w:p13 idle claude s13)" "$(pane w:p14 idle claude s14)" \
    "$(codexpane w:p15 idle "$CODEX_WT")" "$(codexpane w:p16 working "$T/codex-work")" \
    "$(codexpane w:p18 idle "$T/codex-shared")" "$(codexpane w:p18b idle "$T/codex-shared")" \
    "$(codexid w:p19 idle "$T/codex-shared" 0190aaaa-1111-7222-8333-444455556666)" \
    "$(codexid w:p19b idle "$T/codex-gone" 0190ffff-1111-7222-8333-444455556666)" \
    "$(codexid w:x5 idle "$T/codex-shared" '*')" \
    '{"pane_id":"w:p20","agent_status":"idle","agent":"codex","cwd":"'"$T"'/codex-was-claude","agent_session":{"agent":"claude","kind":"id","value":"s1"}}' \
    "$(pane w:p17 idle claude s17)" \
    "$(codexpane w:x1 idle "$T/no-such-worktree")" "$(pane w:x2 idle claude '../s1')" "$(pane w:x3 idle claude '*')" \
    '{"pane_id":"w:local","agent":"local-model","agent_status":"idle"}' \
    '{"pane_id":"w:x4","agent_status":"idle"}'

expect w:p1 "--token ctx=58k --token turn=5m" idle
expect w:p2 "--token ctx=120k --token turn= " working
expect w:p3 "--token ctx=90k --token turn=1h " blocked
expect w:p4 "turn=0m" "done"
expect w:p5 "--token ctx= --token turn= " no-transcript
expect w:p6 "--token ctx=200k " synthetic
expect w:p7 "--token ctx= " compacted
expect w:p8 "--token ctx=30k " after-compact
expect w:p9 "--token ctx=70k " sidechain
expect w:p10 "--token ctx=250k▲ " warn
expect w:p11 "--token ctx=700k▲▲ " alarm
expect w:p12 "--token ctx=5k " broken-line
expect w:p13 "turn=0m" future-clock
expect w:p14 "--token ctx= " subagent-file
expect w:p15 "--token ctx=123k --token turn=5m" codex
expect w:p16 "--token ctx=64k --token turn= " codex-working
expect w:p18 "--token ctx=? --token turn= --token model= " codex-shared-dir
expect w:p18b "--token ctx=? --token turn= --token model= " codex-shared-dir-2
expect w:p19 "--token ctx=41k " codex-session-id
expect w:p19b "--token ctx= --token turn= " codex-session-id-no-rollout
never w:x5 codex-glob-id
expect w:p20 "--token ctx=77k " codex-after-claude
expect w:p17 "--token ctx=30k" local-claude
expect w:x1 "--token ctx= --token turn= " codex-no-session
never w:x2 path-id
never w:x3 glob-id
never w:local unsupported-local-agent
never w:x4 no-session
expect w:p1 "--source agent-office:meter" source
expect w:p1 "--token model=m " unknown-model-label
expect w:p5 "--token model= " no-transcript-model
expect w:p6 "--token model=m " synthetic-model
expect w:p7 "--token model=m " compact-retains-model
expect w:x1 "--token model= " codex-no-model

# Both readers use strict boundaries, absolute limits, and the table's windows.
for agent in claude codex; do
  for spec in 'm 200000 600000' 'claude-haiku-4-5-20251001 100000 150000' 'gpt-5.2-codex 200000 300000'; do
    # shellcheck disable=SC2086 # split the literal test row into three fields
    set -- $spec; model=$1 warn=$2 alarm=$3
    for boundary in "$warn" "$((warn + 1))" "$alarm" "$((alarm + 1))"; do
      mark=; [ "$boundary" -gt "$warn" ] && mark=▲; [ "$boundary" -gt "$alarm" ] && mark=▲▲
      if [ "$agent" = claude ]; then
        u "$boundary" "$model" >"$A/model.jsonl"
        run "$(pane w:model idle claude model)"
      else
        { printf '{"type":"session_meta","payload":{"cwd":"%s"}}\n' "$T/model"
          printf '{"type":"turn_context","payload":{"model":"%s"}}\n' "$model"
          printf '{"type":"token_usage_record","payload":{"usage":{"input_tokens":%s}}}\n' "$boundary"
        } >"$C/rollout-2026-09-29-model.jsonl"
        run "$(codexpane w:model idle "$T/model")"
      fi
      expect w:model "--token ctx=$((boundary / 1000))k$mark " "$agent-$model-$boundary"
    done
  done
done
expect w:model '--token model=gpt-5.2-codex ' codex-label

# Claude labels drop the provider prefix/date and use a dotted version.
# Sidechains, synthetic/error records, and malformed model fields never replace it.
{ u 200001 claude-opus-5-5-20260901
  echo '{"type":"assistant","isSidechain":true,"message":{"model":"claude-haiku-4-5","usage":{"input_tokens":999999}}}'
  echo '{"type":"assistant","message":{"model":"<synthetic>"}}'
  echo '{"type":"assistant","message":{"model":123}}'
  printf '%s\n' '{"type":"assistant","message":{"model":"bad\nmodel"}}'
} >"$A/model.jsonl"
run "$(pane w:model idle claude model)"
expect w:model '--token model=opus-5.5 ' claude-label
expect w:model '--token ctx=200k▲ ' claude-model-filter
u 200001 claude-opus-4-6 >"$A/model.jsonl"
run "$(pane w:model idle claude model)"
expect w:model '--token ctx=200k▲ ' longest-prefix
u 600000 >"$A/model.jsonl"
(METER_WARN=80000 METER_ALARM=120000 run "$(pane w:model idle claude model)")
expect w:model '--token ctx=600k▲▲ ' env-limits

# Codex models can switch; a large response must not hide the turn_context.
{ printf '{"type":"session_meta","payload":{"cwd":"%s","model":"gpt-5.2-codex"}}\n' "$T/model"
  echo '{"type":"turn_context","payload":{"model":"gpt-6.1-sol"}}'
  awk 'BEGIN { for (i=0; i<50000; i++) print "{\"type\":\"padding\"}" }'
  echo '{"type":"event_msg","payload":{"type":"token_count","info":{"last_token_usage":{"input_tokens":350000}}}}'
} >"$C/rollout-2026-09-29-model.jsonl"
run "$(codexpane w:model idle "$T/model")"
expect w:model '--token ctx=350k▲ ' codex-switch-window
expect w:model '--token model=gpt-6.1-sol ' codex-model-before-tail
printf '{"type":"session_meta","payload":{"cwd":"%s","model":"gpt-5.2-codex"}}\n' "$T/model" >"$C/rollout-2026-09-29-model.jsonl"
run "$(codexpane w:model idle "$T/model")"
expect w:model '--token model=gpt-5.2-codex ' codex-meta-fallback

# office install's settings file reaches the meter, wins over the environment, and is read
# again on every pass; one that does not check out is not used
S=$XDG_STATE_HOME/agent-office/meter.json; mkdir -p "$(dirname "$S")"
settings() { printf '{"schema":1,"enabled":%s,"interval_seconds":%s,"warn_tokens":%s,"alarm_tokens":%s}\n' "$@" >"$S"; }
u 150000 >"$A/model.jsonl"
settings true 60 100000 140000
(METER_WARN=300000 METER_ALARM=400000 run "$(pane w:model idle claude model)")
expect w:model '--token ctx=150k▲▲ ' settings-file-limits
expect w:model '--ttl-ms 240000' settings-file-ttl
settings true 30 120000 600000
run "$(pane w:model idle claude model)"
expect w:model '--token ctx=150k▲ ' settings-file-reread
settings true 30 600000 100000 # warn above alarm: not valid
(METER_WARN=300000 METER_ALARM=400000 run "$(pane w:model idle claude model)")
expect w:model '--token ctx=150k ' settings-file-invalid
printf 'not json\n' >"$S"
run "$(pane w:model idle claude model)"
expect w:model '--token ctx=150k --token turn' settings-file-broken
settings false 30 200000 600000
run "$(pane w:model idle claude model)"
never w:model settings-disabled
rm -f "$S"

# quota, branch and PR. A pass never waits for quota-axi or gh: it starts a background read
# into the cache and shows what the last one left there.
Q=$T/state/meter.$(printf default | cksum | cut -d' ' -f1).cache
reads() { # wait up to 5s for the background reads to finish
  i=0; while ls "$Q"/*.lock >/dev/null 2>&1 && [ $i -lt 50 ]; do sleep 0.1; i=$(( i + 1 )); done; }
cwdpane() { # pane status session cwd
  printf '{"pane_id":"%s","agent_status":"%s","agent_session":{"agent":"claude","kind":"id","value":"%s"},"cwd":"%s","foreground_cwd":"%s"}' "$1" "$2" "$3" "$4" "$4"; }
gen=$(date -u +%Y-%m-%dT%H:%M:%S.123Z)
scope() { # name status percent runway [bounds-json] [runway-seconds]
  printf '{"scope":"%s","status":"%s","effectivePercentRemaining":%s,"boundedBy":%s,"runway":{"status":"%s"%s}}' \
    "$1" "$2" "$3" "${5:-[\"five_hour\",\"seven_day\"]}" "$4" "${6:+,\"usableRunwaySeconds\":$6}"; }
provider() { # name stale accounts-json scopes...
  p=$1 st=$2 ac=$3; shift 3
  printf '{"provider":"%s","state":{"status":"fresh","stale":%s},"accountKeys":%s,"quotaSemantics":{"effectiveAvailability":[%s]}}' \
    "$p" "$st" "$ac" "$(IFS=,; echo "$*")"; }
quota() { printf '{"generatedAt":"%s","providers":[%s]}\n' "$gen" "$(IFS=,; echo "$*")"; }
G=$T/repo; mkdir -p "$G/sub"
git -C "$G" init -q -b feat/sidebar && git -C "$G" -c user.name=p -c user.email=p@example.invalid commit -q --allow-empty -m one
echo '{"number":109,"state":"OPEN"}' >"$G/.fakepr"
D=$T/detached; git clone -q "$G" "$D" && git -C "$D" checkout -q --detach
N=$T/nopr; git clone -q "$G" "$N" && git -C "$N" checkout -q -b fix/none
M=$T/merged; git clone -q "$G" "$M" && git -C "$M" checkout -q -b fix/merged
echo '{"number":7,"state":"MERGED"}' >"$M/.fakepr"
quota "$(provider claude false '["default"]' "$(scope all_models known 89.6 through_reset)")" \
  "$(provider codex false '["default"]' "$(scope all_models known 41 projected_exhaustion '["five_hour","weekly"]' 7300)")" >"$T/quota.src"
u 1000 claude-opus-5-5 >"$A/g1.jsonl"
: >"$T/quota.calls"; : >"$T/gh.calls"; rm -f "$Q"/* # what the cases above cached
panes="$(cwdpane w:g1 idle g1 "$G/sub") $(cwdpane w:g2 idle g1 "$D") $(cwdpane w:g3 idle g1 "$N")"
panes="$panes $(cwdpane w:g4 idle g1 "$M") $(cwdpane w:g5 idle g1 "$T") $(codexid w:g6 idle "$G" 0190aaaa-1111-7222-8333-444455556666)"
touch "$T/hold"
# shellcheck disable=SC2086 # one pane object per word, none has a space
run $panes
expect w:g1 "--token quota= --token branch=feat/sidebar --token pr= " first-pass-no-wait
rm -f "$T/hold"; reads
# shellcheck disable=SC2086
run $panes
expect w:g1 "--token quota=89% --token branch=feat/sidebar --token pr=#109 " quota-branch-pr
expect w:g2 "--token branch= --token pr= " detached-head
expect w:g3 "--token branch=fix/none --token pr= " no-pr
expect w:g4 "--token branch=fix/merged --token pr= " merged-pr
expect w:g5 "--token quota=89% --token branch= --token pr= " no-repo
expect w:g6 "--token quota=41%▼2h --token branch=feat/sidebar --token pr=#109 " codex-runway
reads
# shellcheck disable=SC2086
run $panes; reads
[ "$(wc -l <"$T/quota.calls")" -eq 1 ] || { echo "FAIL [quota-cached] quota-axi ran $(wc -l <"$T/quota.calls") times"; fail=1; }
grep -q -- '--no-credential-refresh' "$T/quota.calls" || { echo "FAIL [quota-read-only] $(cat "$T/quota.calls")"; fail=1; }
# one read per checkout and branch, failures included: g1 and g6 share one, no PR is not asked again
[ "$(wc -l <"$T/gh.calls")" -eq 3 ] || { echo "FAIL [gh-cached] gh ran: $(cat "$T/gh.calls")"; fail=1; }
# a reading older than three intervals is not shown, and a new read is started
touch -t 200001010000 "$Q/quota.json"; touch "$T/hold"
run "$(cwdpane w:g1 idle g1 "$G")"
expect w:g1 "--token quota= " quota-too-old
rm -f "$T/hold"; reads
[ "$(wc -l <"$T/quota.calls")" -eq 2 ] || { echo "FAIL [quota-refetch] quota-axi ran $(wc -l <"$T/quota.calls") times"; fail=1; }
qcase() { # want label quota-json : written straight into the cache, as a finished read leaves it
  printf '%s\n' "$3" >"$Q/quota.json"
  run "$(cwdpane w:g1 idle g1 "$T")"
  expect w:g1 "--token quota=$1 " "$2"
}
all=$(scope all_models known 70 through_reset)
qcase '0%▼▼' exhausted "$(quota "$(provider claude false '["default"]' "$(scope all_models known 0 exhausted_now)")")"
qcase '' runway-unknown "$(quota "$(provider claude false '["default"]' "$(scope all_models known 70 unknown)")")"
qcase '' stale "$(quota "$(provider claude true '["default"]' "$all")")"
qcase '' two-accounts "$(quota "$(provider claude false '["a","b"]' "$all")")"
qcase '' no-provider "$(quota "$(provider codex false '["default"]' "$all")")"
qcase '' broken-cache 'not json {'
qcase '' empty-cache ''
qcase '' runway-already-passed "$(quota "$(provider claude false '["default"]' \
  "$(scope all_models known 5 projected_exhaustion '["five_hour"]' 60)")" | sed 's/"generatedAt":"[^"]*"/"generatedAt":"2000-01-01T00:00:00Z"/')"
qcase '70%▼45m' runway-minutes "$(quota "$(provider claude false '["default"]' "$(scope all_models known 70 projected_exhaustion '["five_hour"]' 2760)")")"
# the session model's own scope wins when it carries every account-wide bound; one that does not is
# only part of the picture, so the account-wide scope is shown
u 1000 claude-fable-5-1 >"$A/g1.jsonl"
qcase '12%' model-scope "$(quota "$(provider claude false '["default"]' "$all" \
  "$(scope model:fable known 12 through_reset '["five_hour","seven_day","model:fable"]')")")"
qcase '70%' model-scope-partial "$(quota "$(provider claude false '["default"]' "$all" \
  "$(scope model:fable known 12 through_reset '["model:fable"]')")")"
qcase '70%' other-model-scope "$(quota "$(provider claude false '["default"]' "$all" \
  "$(scope model:haiku known 12 through_reset '["five_hour","seven_day","model:haiku"]')")")"
mv "$T/bin/quota-axi" "$T/quota-axi.off"; rm -f "$Q/quota.json"; : >"$T/quota.calls"
run "$(cwdpane w:g1 idle g1 "$G")"
expect w:g1 "--token quota= " no-quota-axi
mv "$T/quota-axi.off" "$T/bin/quota-axi"

# a pane that closes mid-pass (its report fails) is not a dead server, even when it is listed last
if ! run "$(pane w:p1 idle claude s1)" "$(pane w:gone idle claude s2)"; then echo "FAIL [pane-gone] pass reported a miss"; fail=1; fi
expect w:p1 "ctx=58k" pane-gone
expect w:p1 "--ttl-ms 120000" ttl

# server gone: a pass fails instead of reporting
rm -f "$T/panes.json"; : >"$T/reports"
if HERDR_BIN_PATH=$T/herdr CLAUDE_CONFIG_DIR=$T/cfg sh "$here/meter" once; then echo "FAIL [server-gone] pass succeeded"; fail=1; fi
[ -s "$T/reports" ] && { echo "FAIL [server-gone] reported"; fail=1; }

# the loop gives up after three missed passes instead of spinning forever
HERDR_BIN_PATH=$T/herdr METER_EVERY=0 CLAUDE_CONFIG_DIR=$T/cfg sh "$here/meter" & lp=$!
sleep 2
if kill -0 "$lp" 2>/dev/null; then echo "FAIL [loop-exit] still running after 2s"; kill "$lp"; wait "$lp" 2>/dev/null; fail=1; fi

# a server that is up but not answering (an outage) never stops the loop, however long;
# once it answers again the meter reports again. Synchronised on observed calls, not sleeps.
lines() { if [ -f "$1" ]; then wc -l <"$1" | tr -d ' '; else echo 0; fi; }
until_n() { i=0; while [ "$(lines "$1")" -lt "$2" ] && [ $i -lt 100 ]; do sleep 0.1; i=$(( i + 1 )); done; [ "$(lines "$1")" -ge "$2" ]; }
printf '{"result":{"panes":[%s]}}' "$(pane w:p1 idle claude s1)" >"$T/panes.json"; : >"$T/reports"; : >"$T/misses"; touch "$T/up"
HERDR_BIN_PATH=$T/herdr METER_EVERY=1 CLAUDE_CONFIG_DIR=$T/cfg sh "$here/meter" & lp=$!
until_n "$T/reports" 1 || { echo "FAIL [outage] no first report"; fail=1; }
# the loop's status, for office doctor: what it runs and with which settings, after each pass
i=0; while [ ! -s "$T/state/meter.$(printf default | cksum | cut -d' ' -f1).json" ] && [ $i -lt 30 ]; do sleep 0.1; i=$(( i + 1 )); done
stat=$(cat "$T/state/meter.$(printf default | cksum | cut -d' ' -f1).json" 2>/dev/null)
want=$(sed -n 's/^version = "\(.*\)"$/\1/p' "$here/herdr-plugin.toml")
printf '%s' "$stat" | jq -e --arg v "$want" --arg root "$here" --argjson pid "$lp" '.version == $v and .root == $root
  and .pid == $pid and .settings == {source: "environment", enabled: true, interval_seconds: 1,
  warn_tokens: 200000, alarm_tokens: 600000} and (.last_pass | type) == "number"' >/dev/null ||
  { echo "FAIL [status] $stat"; fail=1; }
mv "$T/panes.json" "$T/panes.off"
until_n "$T/misses" 4 || { echo "FAIL [outage] never retried"; fail=1; }
kill -0 "$lp" 2>/dev/null || { echo "FAIL [outage] loop died during an outage"; fail=1; }
mv "$T/panes.off" "$T/panes.json"
until_n "$T/reports" 2 || { echo "FAIL [outage] no report after recovery"; fail=1; }
if kill "$lp" 2>/dev/null; then wait "$lp" 2>/dev/null; fi
rm -f "$T/up"

# start: one meter per server however often the hook runs; a recycled pid is not trusted;
# a second socket (a named herdr session) gets its own
M="$here/meter"
count() { # top-level meters only: a meter's pipelines fork subshells with the same argv
  ps -A -o pid=,ppid=,args= | awk -v m="sh $M" '
    { sub(/^ +/, ""); p = $1; pp = $2; $1 = $2 = ""; sub(/^ +/, "") }
    $0 == m { is[p] = 1; par[p] = pp }
    END { n = 0; for (p in is) if (!(par[p] in is)) n++; print n }'; }
settle() { # want: wait up to 3s for the meter count to reach it (a busy machine is slow to fork)
  i=0; while [ "$(count)" != "$1" ] && [ $i -lt 30 ]; do sleep 0.1; i=$(( i + 1 )); done; [ "$(count)" = "$1" ]; }
st() { HERDR_BIN_PATH=$T/herdr METER_EVERY=1 CLAUDE_CONFIG_DIR=$T/cfg HERDR_PLUGIN_STATE_DIR=$T/state \
  HERDR_SOCKET_PATH=$1 sh "$here/start"; }
before=$(count)
st /s/one; st /s/one; st /s/one
settle $(( before + 1 )) || { echo "FAIL [start-once] $(( $(count) - before )) meters"; fail=1; }
first=$(cat "$T"/state/meter.*.pid)
sleep 30 & decoy=$!; for f in "$T"/state/meter.*.pid; do echo "$decoy" >"$f"; done
st /s/one
settle $(( before + 2 )) || { echo "FAIL [recycled-pid] did not start a new meter"; fail=1; }
st /s/two
settle $(( before + 3 )) || { echo "FAIL [second-socket] shares a meter"; fail=1; }
# each start records the herdr config the server started with, even when a meter already runs
printf 'x = 1\n' >"$T/herdr.toml"
HERDR_CONFIG_PATH=$T/herdr.toml st /s/one
rec=$(cat "$T/state/meter.$(printf /s/one | cksum | cut -d' ' -f1).server.json" 2>/dev/null)
sum=$({ sha256sum "$T/herdr.toml" 2>/dev/null || shasum -a 256 "$T/herdr.toml"; } | cut -d' ' -f1)
printf '%s' "$rec" | jq -e --arg c "$T/herdr.toml" --arg s "$sum" \
  '.socket == "/s/one" and .herdr_config == $c and .sha256 == $s' >/dev/null ||
  { echo "FAIL [start-record] $rec"; fail=1; }
# the line herdr writes at the top after its first-run setup is not part of the hash
printf 'onboarding = false\nx = 1\n' >"$T/herdr.toml"
HERDR_CONFIG_PATH=$T/herdr.toml st /s/one
rec=$(cat "$T/state/meter.$(printf /s/one | cksum | cut -d' ' -f1).server.json" 2>/dev/null)
printf '%s' "$rec" | jq -e --arg s "$sum" '.sha256 == $s' >/dev/null ||
  { echo "FAIL [start-record-onboarding] $rec"; fail=1; }
{ kill "$decoy"; wait "$decoy"; } 2>/dev/null; kill "$first" 2>/dev/null; for f in "$T"/state/meter.*.pid; do kill "$(cat "$f")" 2>/dev/null; done

[ "$fail" = 0 ] && echo "meter-probe: all cases pass"
exit "$fail"
