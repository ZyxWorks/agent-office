#!/bin/sh
# pre-push: bin/leak-scan over the files of each commit this push sends and every commit on the
# way to it, as git has them (an uncommitted edit neither blocks nor clears a push), with your
# private denylist (~/.config/agent-office/leak-denylist) when you have one. Turn it on once per
# clone with `git config core.hooksPath .githooks` (CONTRIBUTING.md, "Keeping it private").
#
# Git hands a hook one line per ref: <local ref> <local sha> <remote ref> <remote sha>.
set -eu
root=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
status=0
while read -r _ local _ remote; do
  [ "$local" = "$zero" ] && continue                        # a delete sends nothing
  "$root/bin/leak-scan" --rev "$local" || status=1
  if [ "$remote" != "$zero" ] && git cat-file -e "$remote^{commit}" 2>/dev/null; then
    range="$remote..$local"
  else
    # A new branch, or a remote tip this clone has not fetched: what it adds over main.
    base=$(git rev-parse -q --verify origin/main 2>/dev/null || true)
    if [ -z "$base" ]; then
      echo "pre-push: no origin/main to compare with; run git fetch origin, then push again." >&2
      status=1
      continue
    fi
    range="$base..$local"
  fi
  "$root/bin/leak-scan" --commits "$range" || status=1
done
[ "$status" = 0 ] || echo "pre-push: leak-scan found something above. Nothing was pushed." >&2
exit "$status"
